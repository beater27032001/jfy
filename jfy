    minutos = minutos_uteis(abrir_claude(cwd, contexto, pedido, lock, sid), time.time())

    print("\n" + c(" Fim da sessão ", 39, True) + " " + task["title"])
    op = ask(f" 1) pronta: registrar tempo e mover para {status(STATUS_FIM)}\n"
             " 2) não pronta: só registrar o tempo\n"
             " 3) não registrar nada\n> [2] ", "2")
    if op == "3":
        fim(tid, nada=True)
    else:
        m = ask(f"Tempo gasto, já sem as reuniões (80, 1h20) [{fmt_min(minutos)}]: ")
        fim(tid, ler_minutos(m) or minutos, op == "1", modo=modo)
