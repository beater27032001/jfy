def tasks_mudar(campo, valor, *resto):
    """Mudança em lote (as tasks marcadas no app): status, prioridade ou prazo de várias tasks, 4 por vez. Uma que falha
    não para as outras: volta na lista de erros. Status que pede o vídeo do teste (fechado, finalizado validação) leva o
    mesmo link ou motivo para todas: jfy --tasks-mudar status fechado --extra=<link ou motivo> <ids>."""
    from concurrent.futures import ThreadPoolExecutor
    extra = resto[0][len("--extra="):] if resto and resto[0].startswith("--extra=") else ""
    tids = resto[1:] if resto and resto[0].startswith("--extra=") else resto
    if campo not in ("status", "prioridade", "prazo"):
        sys.exit(f"Em lote, só status, prioridade ou prazo (não {campo}).")
    if campo == "status" and valor in PEDE_VIDEO and len(extra.strip()) < 3:
        sys.exit("Esse status pede o link do vídeo do teste (ou o motivo de não ter), que vale para todas as tasks.")
    if not tids:
        sys.exit("Nenhuma task escolhida.")

    def uma(tid):
        try:
            task_mudar(tid, campo, valor, extra)
        except Exception as e:
            return {"id": tid, "erro": str(e)[:200]}
    with ThreadPoolExecutor(4) as ex:
        erros = [e for e in ex.map(uma, tids) if e]
    return {"ok": len(tids) - len(erros), "erros": erros}


