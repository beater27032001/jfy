def enderecos(cabecalho):
    """[(nome, email)] de um cabeçalho To/Cc/From."""
    import email.utils
    return [(n, e) for n, e in email.utils.getaddresses([cabecalho or ""]) if "@" in e]


def montar_email(h, eu, modo, texto, para="", cc="", corpo_original="", assinatura="", assunto_novo=""):
    """O email de resposta ou encaminhamento, a partir dos cabeçalhos do original (h, em minúsculas). responder: para
    quem escreveu (o Reply-To, se houver); todos: e com cópia para os outros de Para e Cc, menos você; encaminhar: para
    quem você disser, com o original citado embaixo. Sempre na mesma conversa (In-Reply-To e References). novo: um
    email do zero (sem original), para quem você disser, com o assunto que você der."""
    import email.utils, html as h_
    from email.message import EmailMessage
    msg, assunto = EmailMessage(), h.get("subject") or ""
    if modo == "novo":
        if "@" not in para:
            sys.exit("Diga para quem enviar.")
        msg["To"], msg["Subject"] = para, assunto_novo.strip() or "(sem assunto)"
        if cc.strip():
            msg["Cc"] = cc
    elif modo == "encaminhar":
        if not para.strip():
            sys.exit("Diga para quem encaminhar.")
        msg["To"], prefixo = para, "Fwd: "
        if cc.strip():
            msg["Cc"] = cc
        texto += ("\n\n---------- Mensagem encaminhada ----------\n" + f"De: {h.get('from', '')}\nData: {h.get('date', '')}\n"
                  f"Assunto: {assunto}\nPara: {h.get('to', '')}\n\n{corpo_original}")
    else:
        destino = h.get("reply-to") or h.get("from", "")
        msg["To"], prefixo = destino, "Re: "
        if modo == "todos":
            fora = {eu.lower()} | {e.lower() for _, e in enderecos(destino)}
            copia = [email.utils.formataddr((n, e)) for n, e in enderecos(h.get("to", "")) + enderecos(h.get("cc", "")) if e.lower() not in fora]
            if copia:
                msg["Cc"] = ", ".join(dict.fromkeys(copia))
    if modo != "novo":
        ja = assunto.lower().startswith(("re:", "fwd:", "fw:", "enc:"))
        msg["Subject"] = assunto if ja and assunto.lower().startswith(prefixo.lower().strip()) else prefixo + assunto
    if h.get("message-id"):  # para o Gmail (e quem recebe) juntar na mesma conversa
        msg["In-Reply-To"] = h["message-id"]
        msg["References"] = (h.get("references", "") + " " + h["message-id"]).strip()
    msg.set_content(texto + (f"\n\n-- \n{html_texto(assinatura)}" if assinatura else ""))
    if assinatura:  # a versão HTML leva a assinatura como ela é no Gmail (com logo, links, cores)
        msg.add_alternative(f"<div>{h_.escape(texto).replace(chr(10), '<br>')}</div><br><div>{assinatura}</div>", subtype="html")
    return msg


def anexos_do_email(tok, mid, payload):
