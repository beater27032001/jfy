def app_abas(acao, **dados):
    """As abas do app do Windows (Electron, node-pty no lugar do tmux): POST /abas/<acao> no app, que está em JFY_APP.
    listar → {"abas": [{id, nome, chave, cwd, ativa, focada}]}; abrir {nome, cor, chave, argv}; ir {id};
    escrever {id, texto}; mensagem {texto}."""
    url, tok = APP.rsplit("|", 1)
    req = urllib.request.Request(f"{url}/abas/{acao}", json.dumps(dados).encode(),
                                 {"Content-Type": "application/json", "Authorization": f"Bearer {tok}"})
    # sem proxy: um proxy da empresa (que o Windows passa ao Python) não alcança o 127.0.0.1 do app
    with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=10) as r:
        return json.load(r)


def na_aba():
    """Este jfy roda dentro de uma aba (do tmux ou do app), e não num comando de fundo do app."""
    return bool(os.environ.get("TMUX") or os.environ.get("JFY_ABA"))


def aba(chave):
    """Id da aba que já roda esta coisa ('--run <id>', '--livre <pasta>'...), ou None."""
    if APP:
        return next((x["id"] for x in app_abas("listar")["abas"] if x.get("chave") == chave), None)
    abas = subprocess.run(TMUX + ["list-windows", "-F", "#{window_id}\t#{@jfy}"], capture_output=True, text=True).stdout
    return next((w for w, k in (l.split("\t", 1) for l in abas.splitlines() if "\t" in l) if k == chave), None)


def abrir_aba(nome, pid_proj, *args):
    """Abre a aba. Se a mesma coisa (mesma task, reunião, pasta) já tem aba, só vai para ela: abrir duas vezes a mesma
    task brigava pelo worktree e a segunda aba quebrava."""
    chave = " ".join(args[:2])  # --run <id> vale para /pipeline e livre
    wid = aba(chave)
    if APP:
        return app_abas("ir", id=wid) if wid else app_abas("abrir", nome=nome, cor=cor_hex(pid_proj), chave=chave, argv=[*EU, *args])
    if wid:
        return subprocess.run(TMUX + ["select-window", "-t", wid])
    # o tmux expande formatos no nome da janela: "#" vira "##" para o título (de task, reunião, PR) aparecer como é,
    # sem virar formato (e um "#(...)" num título nunca ser lido como comando, em versão nenhuma do tmux)
    wid = subprocess.run(TMUX + ["new-window", "-P", "-F", "#{window_id}", "-n", nome.replace("#", "##"), SELF, *args],
                         capture_output=True, text=True).stdout.strip()
    subprocess.run(TMUX + ["set-window-option", "-t", wid, "window-status-style", f"fg=colour{cor_projeto(pid_proj)}"])
    subprocess.run(TMUX + ["set-window-option", "-t", wid, "@jfy", chave])


