def emails_json(caixa="nao_lidos", modo=""):
    """Aba Emails: os não lidos da Principal, ou os importantes (como a pasta Importantes do Gmail, sem os que você
    enviou), os 50 mais novos com remetente e assunto, e o total (até 100). O total de não lidos vai sempre junto:
    é o selo da barra lateral.
    Com modo "cache", devolve na hora a última lista guardada (o app mostra enquanto a busca de verdade roda por trás);
    sem guardada, busca. A busca guarda a lista e diz se ela "mudou" desde a última: o app só redesenha quando muda.
    O remetente, o assunto e a data de cada email ficam guardados por id: só o email novo vai ao Gmail. O lido/não lido
    vem sempre da busca da vez."""
    from concurrent.futures import ThreadPoolExecutor
    if caixa not in ("nao_lidos", "importantes"):
        sys.exit("Use nao_lidos ou importantes.")
    arq = lista_email_guardada(caixa)
    try:
        antes = json.load(open(arq))
    except (OSError, ValueError):
        antes = None
    if modo == "cache" and antes:
        return dict(antes, cache=True)
    tok = caixa_google()
    nao_lidos = gmail_nao_lidos(tok)
    guardar_ids(nao_lidos)
    if caixa == "nao_lidos":
        ids, sem_ler = nao_lidos, set(nao_lidos)
    else:
        busca = lambda q: [m["id"] for m in http_json(f"{GMAIL}?{urllib.parse.urlencode({'q': q, 'maxResults': 100})}",
                                                       token=tok).get("messages", [])]
        ids, sem_ler = busca("is:important -in:sent -in:chats"), set(busca("is:important is:unread -in:sent -in:chats"))
    try:
        guardados = json.load(open(ITENS_EMAIL))
    except (OSError, ValueError):
        guardados = {}
    novos = [i for i in ids[:50] if i not in guardados]
    with ThreadPoolExecutor(8) as ex:
        guardados.update(zip(novos, ex.map(lambda i: gmail_item(tok, i), novos)))
    itens = [dict(guardados[i], lido=i not in sem_ler) for i in ids[:50]]
    # ponytail: guarda os 1000 mais novos; email mais antigo que isso, se aparecer de novo, é buscado de novo
    gravar_json(ITENS_EMAIL, dict(sorted(guardados.items(), key=lambda kv: -kv[1].get("ts", 0))[:1000]))
    r = {"conta": conta_gmail(tok), "url": url_gmail(conta_gmail(tok)), "total": len(ids), "mais": len(ids) >= 100,
         "nao_lidos": len(nao_lidos), "emails": itens, "em": time.time()}
    marca = lambda x: (x["total"], x["nao_lidos"], [(e["id"], e["lido"]) for e in x["emails"]]) if x else None
    gravar_json(arq, r)
    return dict(r, mudou=marca(r) != marca(antes))


