def ligar_pipeline():
    """No Windows, a pipeline vai para o ~/.claude por cópia (symlink pede o modo de desenvolvedor). Como o ligar() do
    install.sh, não sobrescreve arquivo seu: só troca o que a cópia anterior pôs lá. Devolve os que ficaram como estavam."""
    import hashlib
    h = lambda b: hashlib.sha256(b).hexdigest()
    reg_arq, claude = os.path.join(HOME, "pipeline-copias.json"), os.path.expanduser("~/.claude")
    reg = json.load(open(reg_arq)) if os.path.exists(reg_arq) else {}
    pares = [(os.path.join(PIPE, "pipeline.md"), os.path.join(claude, "commands", "pipeline.md"))]
    for sub, ext, destino in (("agents", ".md", ("agents",)), ("hooks", ".sh", ("hooks", "pipeline"))):
        pasta = os.path.join(PIPE, sub)
        pares += [(os.path.join(pasta, f), os.path.join(claude, *destino, f))
                  for f in sorted(os.listdir(pasta) if os.path.isdir(pasta) else []) if f.endswith(ext)]
    mantidos = []
    for src, dst in pares:
        novo = open(src, "rb").read()
        if os.path.exists(dst):
            atual = open(dst, "rb").read()
            if atual != novo and reg.get(dst) != h(atual):
                mantidos.append(dst)
                continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        open(dst, "wb").write(novo)
        reg[dst] = h(novo)
    json.dump(reg, open(reg_arq, "w"), indent=1)
    return mantidos


