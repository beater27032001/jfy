    Reunião não vira task: o tempo vai para as horas (categoria Reunião) do projeto."""
    cfg = load()
    ev = next((e for e in eventos_hoje() if abs(e[0] - float(ini)) < 1), None)
    if not ev:
        return ask(c("Reunião não está mais na agenda de hoje. Enter fecha.", 203))
    i, f, titulo, link, det = (ev + ["", ""])[:5]
    info = reuniao_info(i, titulo) or {}
    pid = info.get("pid")
    proj = cfg["projetos"].get(pid)
    hora = lambda x: datetime.fromtimestamp(x).strftime("%H:%M")
