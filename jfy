def arquivo_enviar(caminho, onde, alvo):
    """jfy --arquivo-enviar <arquivo> task|projeto <id>: anexa um arquivo a uma task (um print, o vídeo do teste) ou
    manda para o Drive do projeto. Até 3 MB vai junto na chamada; maior, o MCP devolve um link: o arquivo vai direto
    por PUT (com os headers que ele mandou) e o confirmar_envio registra. Anexo de task: até 20 MB (vídeo, 100 MB)."""
    import mimetypes
    if onde not in ("task", "projeto") or not os.path.isfile(caminho):
        sys.exit("Use: jfy --arquivo-enviar <arquivo> task|projeto <id>")
    nome, tam = os.path.basename(caminho)[:200], os.path.getsize(caminho)
    base = {"nome": nome, "tipo": mimetypes.guess_type(nome)[0] or "application/octet-stream", "tamanho": tam,
            ("taskId" if onde == "task" else "projetoId"): alvo}
    if tam <= 3 * 1024 * 1024:
        return mcp("enviar_arquivo", conteudoBase64=base64.b64encode(open(caminho, "rb").read()).decode(), **base) or {"ok": True}
    r = mcp("enviar_arquivo", **base)
    link = pega(r, "url", "uploadUrl", "link")
    if not link:
        sys.exit(f"O Journify não devolveu o link de envio: {str(r)[:200]}")
    with open(caminho, "rb") as f:  # o arquivo vai inteiro do disco para o link, sem passar pelo MCP
        req = urllib.request.Request(link, data=f, method=pega(r, "metodo", "method") or "PUT",
                                     headers=dict(pega(r, "headers") or {}, **{"Content-Length": str(tam)}))
        with urllib.request.urlopen(req, timeout=600) as resp:
            corpo = resp.read().decode("utf-8", "replace")
    if onde == "task":
        return mcp("confirmar_envio", taskId=alvo, caminho=pega(r, "caminho", "path"), nome=nome) or {"ok": True}
    drive = pega(r, "driveFileId") or (json.loads(corpo).get("id") if corpo.strip().startswith("{") else None)
    return mcp("confirmar_envio", projetoId=alvo, driveFileId=drive) or {"ok": True}


