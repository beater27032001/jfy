# ---------- barra do tmux (reunião, uso da IA, jornada) e notificações do macOS ----------
def notificar(titulo, texto, abrir=None, executar=None):
    """Notificação do macOS. Com o terminal-notifier (o install.sh instala), o clique traz o terminal e abre o link
    (`abrir`) ou roda o comando (`executar`, ex.: ir para a aba do Claude). Sem ele, a do osascript (clique não faz nada)."""
    tn = shutil.which("terminal-notifier") or next((x for x in ("/opt/homebrew/bin/terminal-notifier",
                                                                 "/usr/local/bin/terminal-notifier") if os.path.exists(x)), None)
    if tn:
        app = os.environ.get("__CFBundleIdentifier")  # o terminal de onde o jfy (ou o Claude) foi aberto
        extra = (["-open", abrir] if abrir else []) + (["-execute", executar] if executar else []) \
            + (["-activate", app] if app and not abrir else [])
        if subprocess.run([tn, "-title", titulo, "-message", texto.lstrip("-[") or " ", "-sound", "Glass", *extra],
                          capture_output=True).returncode == 0:
            return
        # sem permissão em Ajustes > Notificações (ou outro erro): cai na do osascript para o aviso não sumir
    subprocess.run(["osascript", "-e", "on run a", "-e",
                    'display notification (item 2 of a) with title (item 1 of a) sound name "Glass"',
                    "-e", "end run", titulo, texto])


def cmd_tmux(*args):
    """Linha de shell que roda um comando no tmux do jfy (para o clique da notificação, que roda fora dele)."""
    import shlex
    return " ".join(shlex.quote(x) for x in [shutil.which("tmux") or "tmux", "-L", "jfy", *args])


def cronometro(acao=None):
    """Blocos de trabalho de hoje em ~/.jfy/dia.json. acao 'ligar': só se ainda não ligou hoje;
    'alternar': pausa/retoma; 'zerar': volta a zero e começa de novo agora. Devolve (minutos hoje, rodando?)."""
    # ponytail: bloco esquecido aberto morre na virada do dia; o dia seguinte começa do zero
    try:
        d = json.load(open(DIA))
    except (OSError, ValueError):
        d = {}
    if d.get("data") != date.today().isoformat():
        d = {"data": date.today().isoformat(), "blocos": []}
    b, agora = d["blocos"], time.time()
    rodando = bool(b) and b[-1][1] is None
    if acao == "zerar":
        b[:] = [[agora, None]]
    elif acao == "alternar" and rodando:
        b[-1][1] = agora
    elif acao == "alternar" or (acao == "ligar" and not b):
        b.append([agora, None])
    if acao:
        json.dump(d, open(DIA, "w"))
    return int(sum((f or agora) - i for i, f in b) // 60), bool(b) and b[-1][1] is None


def barra_ia():
    """Uso dos limites do Claude (janela de 5h e semana), do JSON que o statusline do Claude Code grava em USO."""
    # Claude recém-aberto grava sem rate_limits (só vêm após a 1ª resposta) e o tee trunca antes de escrever:
    # nesses casos usa a última leitura boa, guardada em USO + ".ok"
    for arq in (USO, USO + ".ok"):
        try:
            rl = json.load(open(arq))["rate_limits"]
            j5, j7 = rl.get("five_hour") or {}, rl.get("seven_day") or {}
            break
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            pass
    else:
        return ""
    ok = USO + ".ok"
    if arq == USO and os.path.getmtime(USO) > (os.path.getmtime(ok) if os.path.exists(ok) else 0):  # só se mudou
        json.dump({"rate_limits": rl}, open(ok, "w"))
    vivo = lambda j: time.time() < j.get("resets_at", 0)  # janela que já resetou desde a última gravação = 0%
    p5 = round(j5.get("used_percentage", 0)) if vivo(j5) else 0
    p7 = round(j7.get("used_percentage", 0)) if vivo(j7) else 0
    cheio = min(10, round(p5 / 10))
    ate = " até " + datetime.fromtimestamp(j5["resets_at"]).strftime("%H:%M") if vivo(j5) else ""
    cor = 203 if p5 >= 80 else 214 if p5 >= 50 else 78
    return f"#[fg=colour{cor}]IA {ic('cheio') * cheio}{andador()}{ic('vazio') * (10 - cheio)} {p5}%{ate} #[fg=colour244]· semana {p7}%  "


ESCOPOS = ["https://www.googleapis.com/auth/calendar.events.readonly",  # só lê eventos
           "https://www.googleapis.com/auth/gmail.readonly"]  # lê o email no popup do ✉; não marca, não apaga, não envia
# gmail.metadata não entra junto: com ele no token o Gmail recusa format=full mesmo tendo o readonly
TOKEN_URL = "https://oauth2.googleapis.com/token"
GMAIL = "https://gmail.googleapis.com/gmail/v1/users/me/messages"


def chaves(servico, valor=None):
    """Lê (ou grava, com valor) um segredo no Chaves do macOS. Grava pelo stdin do 'security -i', fora da linha
    de comando (que aparece no ps)."""
    if valor is None:
        return subprocess.run(["security", "find-generic-password", "-a", "jfy", "-s", servico, "-w"],
                              capture_output=True, text=True).stdout.strip()
    esc = valor.replace("\\", "\\\\").replace('"', '\\"')
    subprocess.run(["security", "-i"], input=f'add-generic-password -U -a jfy -s {servico} -w "{esc}"\n',
                   text=True, check=True, capture_output=True)


def http_json(url, dados=None, token=None):
    """GET (ou POST de formulário) no Google; erro HTTP vira mensagem com o motivo (API desligada, escopo negado...)."""
    req = urllib.request.Request(url, dados and urllib.parse.urlencode(dados).encode(),
                                 {"Authorization": "Bearer " + token} if token else {})
    try:
        return json.load(urllib.request.urlopen(req, timeout=20))
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"Google {e.code}: {e.read().decode(errors='replace')[:300]}") from None


def google_token():
    """Access token (vale 1h), reaproveitado do Chaves até 5min antes de vencer; depois renova com o refresh
    token que o jfy --login guardou."""
    try:
        t = json.loads(chaves("jfy-google-acesso"))
        if t["expira"] - time.time() > 300:
            return t["token"]
    except (ValueError, KeyError, TypeError):
        pass
    cli, rt = load().get("google"), chaves("jfy-google")
    if not cli or not rt:
        raise RuntimeError("Google não conectado: rode jfy --login")
    r = http_json(TOKEN_URL, dict(cli, refresh_token=rt, grant_type="refresh_token"))
    chaves("jfy-google-acesso", json.dumps({"token": r["access_token"], "expira": time.time() + r.get("expires_in", 3600)}))
    return r["access_token"]


def login():
    """Login do Google (app Interno da empresa): abre o navegador, recebe o código em 127.0.0.1 (PKCE + state)
    e guarda o refresh token no Chaves."""
    import base64, hashlib, http.server, secrets
    cfg = load()
    if not cfg.get("google"):
        arq = ask("Arraste aqui o JSON do client OAuth (baixado no Google Cloud) e dê Enter:\n> ")
        j = json.load(open(os.path.expanduser(arq.strip("'\" ").replace("\\ ", " "))))["installed"]
        cfg["google"] = {"client_id": j["client_id"], "client_secret": j["client_secret"]}
    cli, recebido = cfg["google"], {}
    verif, estado = secrets.token_urlsafe(64), secrets.token_urlsafe(16)
    desafio = base64.urlsafe_b64encode(hashlib.sha256(verif.encode()).digest()).rstrip(b"=").decode()

    class Volta(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            recebido.update(urllib.parse.parse_qsl(urllib.parse.urlparse(self.path).query))
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write("<h2>jfy: pode fechar esta aba e voltar para o terminal.</h2>".encode())

        def log_message(self, *a):
            pass

    srv = http.server.HTTPServer(("127.0.0.1", 0), Volta)
    volta = f"http://127.0.0.1:{srv.server_port}"
    url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
        "client_id": cli["client_id"], "redirect_uri": volta, "response_type": "code", "scope": " ".join(ESCOPOS),
        "code_challenge": desafio, "code_challenge_method": "S256", "state": estado,
        "access_type": "offline", "prompt": "consent"})
    subprocess.run(["open", url])
    print(f"Abri o login do Google no navegador. Se não abriu, cole isto nele:\n{url}\n")
    while "code" not in recebido and "error" not in recebido:  # ignora /favicon.ico e afins
        srv.handle_request()
    srv.server_close()
    if recebido.get("state") != estado or "code" not in recebido:
        return print(c(f"Login não concluído: {recebido.get('error', 'resposta inválida')}", 203))
    tok = http_json(TOKEN_URL, dict(cli, code=recebido["code"], redirect_uri=volta,
                                    grant_type="authorization_code", code_verifier=verif))
    chaves("jfy-google", tok["refresh_token"])
    chaves("jfy-google-acesso", json.dumps({"token": tok["access_token"], "expira": time.time() + tok.get("expires_in", 3600)}))
    save(cfg)
    try:
        n, m = len(agenda_google()), len(gmail_nao_lidos(tok["access_token"]))
        print(c(f"Google conectado: {n} reunião(ões) hoje, {m} email(s) não lido(s) na Principal.", 78))
    except Exception as e:
        print(c(f"Login salvo, mas a leitura falhou: {e}\nConfira se liberou agenda e Gmail na tela do Google "
                "e se as duas APIs estão ativadas no projeto.", 214))


def reunioes(itens):
    """Eventos da API do Google Agenda -> [[início, fim, título, link da chamada, participantes + descrição]]
    (epoch), sem: dia inteiro, cancelado, recusado por você, ausência e local de trabalho."""
    ts = lambda x: datetime.fromisoformat(x["dateTime"].replace("Z", "+00:00")).timestamp()
    out = []
    for e in itens:
        if "dateTime" not in e.get("start", {}) or e.get("status") == "cancelled" \
                or e.get("eventType") in ("outOfOffice", "workingLocation") \
                or any(a.get("self") and a.get("responseStatus") == "declined" for a in e.get("attendees", [])):
            continue
        # Meet; senão a chamada do conferenceData (Zoom, Teams); senão o local, se for um link
        video = [p["uri"] for p in e.get("conferenceData", {}).get("entryPoints", []) if p.get("entryPointType") == "video"]
        local = e.get("location", "")
        link = e.get("hangoutLink") or (video[0] if video else local if local.startswith("http") else "")
        quem = ", ".join(a.get("displayName") or a.get("email", "") for a in e.get("attendees", []) if not a.get("self"))
        det = (f"Participantes: {quem}\n" if quem else "") + (e.get("description") or "")[:2000]
        out.append([ts(e["start"]), ts(e["end"]), e.get("summary") or "(sem título)", link, det])
    return sorted(out)


def agenda_google(dia=None):
    """Reuniões do dia na agenda principal; o Google já expande as recorrentes (singleEvents)."""
    ini = datetime.combine(dia or date.today(), datetime.min.time()).astimezone()  # meia-noite local, com fuso
    q = {"timeMin": ini.isoformat(), "timeMax": (ini + timedelta(days=1)).isoformat(),
         "singleEvents": "true", "orderBy": "startTime", "maxResults": 250}
    return reunioes(http_json("https://www.googleapis.com/calendar/v3/calendars/primary/events?"
                              + urllib.parse.urlencode(q), token=google_token()).get("items", []))


def gmail_nao_lidos(token):
    """Ids dos não lidos da aba Principal da caixa de entrada, do mais novo para o mais antigo (até 100)."""
    q = urllib.parse.urlencode([("labelIds", x) for x in ("INBOX", "UNREAD", "CATEGORY_PERSONAL")] + [("maxResults", 100)])
    return [m["id"] for m in http_json(f"{GMAIL}?{q}", token=token).get("messages", [])]


def gmail_meta(token, mid):
    """(recebido em segundos, remetente, assunto) só pelos metadados (não marca como lido)."""
    import email.utils
    m = http_json(f"{GMAIL}/{mid}?format=metadata&metadataHeaders=From&metadataHeaders=Subject", token=token)
    h = {x["name"].lower(): x["value"] for x in m["payload"]["headers"]}
    nome, end = email.utils.parseaddr(h.get("from", ""))
    return int(m.get("internalDate", 0)) // 1000, nome or end, h.get("subject") or "(sem assunto)"


def gmail_cabecalho(token, mid):
    """'Remetente: assunto' de um email (aviso de email novo na barra)."""
    _, nome, assunto = gmail_meta(token, mid)
    return f"{nome}: {assunto}"


def email_barra():
    """✉ na barra: não lidos da Principal e, por 5min, o email que acabou de chegar. Olha o Gmail a cada ~25s
    (a barra roda a cada 1s), inclusive quando dá erro (não fica martelando o Google)."""
    if not load().get("google"):
        return ""
    try:
        st = json.load(open(EMAIL))
    except (OSError, ValueError):
        st = {}
    if time.time() - st.get("checado", 0) > 25:
        st["checado"] = time.time()
        try:
            tok = google_token()
            ids = gmail_nao_lidos(tok)
            # novo = mais recente que o maior id já visto (o id do Gmail cresce com o tempo). Comparar com a
            # lista anterior dava falso alarme: com 100+ não lidos, ler os recentes puxa antigos para a janela.
            primeira, maior = "maior" not in st, st.get("maior") or "0"  # 1ª olhada só marca a base
            novos = [] if primeira else [i for i in ids if int(i, 16) > int(maior, 16)]
            st.update(erro=False, ids=ids, maior=max(ids + [maior], key=lambda x: int(x, 16)))
            if novos:
                st.update(novo=gmail_cabecalho(tok, novos[0]), novo_id=novos[0], chegou=time.time())
                cliente = "$(" + cmd_tmux("list-clients", "-F", "#{client_tty}") + " | head -1)"
                notificar("Email novo", st["novo"], executar=cmd_tmux("display-popup", "-E", "-w", "90%", "-h", "85%",
                                                                      "-T", " jfy: emails ", SELF + " --email")
                          .replace("display-popup", f'display-popup -c "{cliente}"', 1))
        except Exception:
            st["erro"] = True
        json.dump(st, open(EMAIL, "w"))
    # range=user|email: o clique nesse trecho abre o leitor (jfy --email, ver o tmux.conf); o visual não muda
    if time.time() - st.get("chegou", 0) < 300:
        return f"#[range=user|email fg=colour232,bg=colour214,bold] {ic('email')} {st['novo'][:45].replace('#', '##')} #[default norange]  "
    if st.get("erro"):
        return f"#[range=user|email fg=colour203]{ic('email')} erro (jfy --login)#[norange]  "
    n = len(st.get("ids", []))
    return f"#[range=user|email fg=colour39]{ic('email')} {n}{'+' if n >= 100 else ''}#[norange]  " if n \
        else f"#[range=user|email fg=colour244]{ic('email')}#[norange]  "  # caixa zerada: só o ícone


def corpo_email(payload):
    """Texto de um email (payload do format=full): o text/plain; se não houver, o text/html sem as tags.
    Devolve (texto, [anexos])."""
    import base64, html
    partes, achado, anexos = [payload], {}, []
    while partes:
        p = partes.pop(0)
        partes += p.get("parts", [])
        if p.get("filename"):
            anexos.append(p["filename"])
        elif p.get("mimeType") in ("text/plain", "text/html") and p.get("body", {}).get("data"):
            achado.setdefault(p["mimeType"], base64.urlsafe_b64decode(p["body"]["data"] + "==").decode(errors="replace"))
    if "text/plain" in achado:
        return achado["text/plain"].strip(), anexos
    h = re.sub(r"(?is)<(style|script|head)\b.*?</\1>", "", achado.get("text/html", ""))
    h = re.sub(r"(?i)<br\s*/?>|</(p|div|tr|li|h\d)>", "\n", h)
    txt = html.unescape(re.sub(r"<[^>]+>", "", h))
    return re.sub(r"\n\s*\n+", "\n\n", re.sub(r"[ \t\xa0]+", " ", txt)).strip(), anexos


def ler_email(tok, mid):
    """Abre um email no less (q volta). Só lê: continua não lido no Gmail."""
    m = http_json(f"{GMAIL}/{mid}?format=full", token=tok)
    h = {x["name"].lower(): x["value"] for x in m["payload"]["headers"]}
    texto, anexos = corpo_email(m["payload"])
    topo = (f"{c('De:', 39, True)} {h.get('from', '')}\n{c('Para:', 39, True)} {h.get('to', '')}\n"
            f"{c('Data:', 39, True)} {h.get('date', '')}\n{c(h.get('subject') or '(sem assunto)', 255, True)}\n"
            + (dim("Anexos: " + ", ".join(anexos)) + "\n" if anexos else ""))
    link = f"https://mail.google.com/mail/u/0/#inbox/{m['threadId']}"
    subprocess.run(["less", "-R", "-Ps q volta "], input=f"{topo}\n{texto}\n\n{dim('No Gmail: ' + link)}\n", text=True)


def ler_emails():
    """Clique no ✉ da barra (popup do tmux): não lidos da Principal. Se acabou de chegar um, abre ele direto."""
    from concurrent.futures import ThreadPoolExecutor
    try:
        tok = google_token()
        st = json.load(open(EMAIL)) if os.path.exists(EMAIL) else {}
        if time.time() - st.get("chegou", 0) < 300 and st.get("novo_id"):
            ler_email(tok, st.pop("novo_id"))
            json.dump(dict(st, chegou=0), open(EMAIL, "w"))  # leu o aviso: a barra volta ao contador
        ids = gmail_nao_lidos(tok)[:30]
        with ThreadPoolExecutor(8) as ex:
            metas = list(ex.map(lambda i: gmail_meta(tok, i), ids))
    except Exception as e:
        return ask(c(f"Gmail: {e}\n" + ("Rode jfy --login de novo para liberar a leitura dos emails.\n" if "403" in str(e) else "")
                     + "Enter fecha.", 203))
    while True:
        larg = shutil.get_terminal_size().columns or 100
        quando = lambda ts: datetime.fromtimestamp(ts).strftime("%H:%M" if date.fromtimestamp(ts) == date.today() else "%d/%m")
        itens = [f"{dim(quando(ts))}  {c(corta(nome, 22).ljust(22), 255, True)}  {corta(assunto, larg - 40)}"
                 for ts, nome, assunto in metas]
        op = menu(f"Emails não lidos ({len(ids)}) · Principal", itens or [(dim("caixa zerada"),)],
                  [("número", "lê"), ("o + número", "abre no Gmail")], zero="fecha")
        n = op.lstrip("o")
        if not (n.isdigit() and 1 <= int(n) <= len(ids)):
            return
        try:
            if op.startswith("o"):
                m = http_json(f"{GMAIL}/{ids[int(n) - 1]}?format=minimal", token=tok)
                subprocess.run(["open", f"https://mail.google.com/mail/u/0/#inbox/{m['threadId']}"])
            else:
                ler_email(tok, ids[int(n) - 1])
        except Exception as e:
            ask(c(f"Erro: {e}. Enter volta.", 203))


def eventos_hoje(forcar=False):
    """Reuniões de hoje, com cache: busca no máximo a cada 2min (reunião marcada agora aparece logo); sem rede, fica com o que tinha."""
    hoje = date.today().isoformat()
    if not load().get("google"):
        return []
    try:
        cache = json.load(open(AGENDA))
    except (OSError, ValueError):
        cache = {}
    if forcar or cache.get("data") != hoje or time.time() - cache.get("baixado", 0) > 120:
        try:
            cache = {"data": hoje, "baixado": time.time(), "eventos": agenda_google()}
            json.dump(cache, open(AGENDA, "w"))
        except Exception:  # rede fora ou login revogado não derruba a barra; o jfy --login mostra o erro
            pass
    return cache.get("eventos", []) if cache.get("data") == hoje else []


def proxima_reuniao():
    """Contagem regressiva: reunião que começa em até 1h, ou que está rolando. Notifica uma vez a 5 min."""
    agora = time.time()
    for i, f, t, *r in eventos_hoje():
        if f > agora and i - agora <= 3600:
            m = int((i - agora + 59) // 60)
            marca = os.path.join(RUN_DIR, "reuniao-avisada")
            if 0 < i - agora <= 300 and (not os.path.exists(marca) or open(marca).read() != f"{i}"):
                open(marca, "w").write(f"{i}")
                notificar(f"Reunião em {fmt_min(m)}", t + (" · clique para entrar na chamada" if r and r[0] else ""),
                          abrir=r[0] if r and r[0] else None)
            cor = 203 if m <= 5 else 214 if m <= 15 else 39
            # range=user|reuniao: clicar entra na chamada (jfy --entrar, ver o tmux.conf)
            return (f"#[range=user|reuniao fg=colour{cor},bold]{ic('reuniao')} {t[:24].replace('#', '##')} "
                    f"{'agora' if i <= agora else 'em ' + fmt_min(m)}#[default norange]  ")
    return ""


def relogio():
    """Texto da barra do tmux, uma linha por segundo (o andador do tema anda). Fica rodando: o tmux mostra a última
    linha e não chama de novo enquanto ele vive, então não sobe um Python por segundo. Sai quando o jfy muda (o tmux
    sobe o novo no próximo redesenho, até 15s) e quando o tmux fecha. Avisa uma vez por dia quando fecha a jornada."""
    global TEMA
    versao = os.path.getmtime(SELF)
    while os.path.getmtime(SELF) == versao:
        TEMA = TEMAS.get(load().get("tema"), {})  # tema trocado no menu vale aqui sem reiniciar
        m, rodando = cronometro()
        marca, hoje = os.path.join(RUN_DIR, "jornada-avisada"), date.today().isoformat()
        if m >= JORNADA and (not os.path.exists(marca) or open(marca).read() != hoje):
            open(marca, "w").write(hoje)
            notificar("jfy", f"Jornada de {JORNADA // 60}h fechada: {fmt_min(m)} hoje.")
        if not m and not rodando:
            jornada = f"#[fg=colour244]{ic('jornada')} jornada não começou "
        else:
            cor, icone = (78, ic("feito")) if m >= JORNADA else (220, ic("jornada")) if rodando else (244, ic("pausa") + " pausado")
            jornada = f"#[fg=colour{cor},bold]{icone} {fmt_min(m)} / {JORNADA // 60}h#[default] "
        print(tematizar(proxima_reuniao() + email_barra() + barra_ia() + jornada), flush=True)
        time.sleep(1)


def resumo_dia():
    """Reuniões de hoje e tasks no foco. Usado pelo jfy --hoje e pela notificação das 7h."""
    cfg, urgentes, evs = load(), foco(mcp("minhas_tasks")), eventos_hoje(forcar=True)
    linhas = [c(datetime.fromtimestamp(i).strftime("%H:%M"), 39, True) + f"  {t}" for i, _, t, *_ in evs]
    return f"{len(evs)} reunião(ões) · {len(urgentes)} task(s) no foco", linhas + [linha_foco(cfg, t) for t in urgentes]


def notificar_dia():
