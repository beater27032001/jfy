def dpapi(dados, cifrar):
    """Cifra (ou decifra) com a DPAPI do Windows: só o mesmo usuário, nesta máquina, abre de volta."""
    import ctypes
    from ctypes import wintypes as w

    class Blob(ctypes.Structure):
        _fields_ = [("n", w.DWORD), ("p", ctypes.POINTER(ctypes.c_char))]
    buf = ctypes.create_string_buffer(dados, len(dados))
    ent, sai = Blob(len(dados), ctypes.cast(buf, ctypes.POINTER(ctypes.c_char))), Blob()
    f = ctypes.windll.crypt32.CryptProtectData if cifrar else ctypes.windll.crypt32.CryptUnprotectData
    if not f(ctypes.byref(ent), None, None, None, None, 0, ctypes.byref(sai)):
        raise OSError(f"DPAPI falhou ({ctypes.GetLastError()})")
    try:
        return ctypes.string_at(sai.p, sai.n)
    finally:
        ctypes.windll.kernel32.LocalFree(sai.p)


def chaves(servico, valor=None):
    """Lê (ou grava, com valor) um segredo no Chaves do macOS. Grava pelo stdin do 'security -i', fora da linha
    de comando (que aparece no ps). No Windows, um arquivo cifrado pela DPAPI em ~/.jfy/segredos."""
    if WIN:  # ponytail: DPAPI e não o Gerenciador de Credenciais, que corta o segredo em 2,5 KB
        arq = os.path.join(HOME, "segredos", servico)
        if valor is None:
            try:
                return dpapi(open(arq, "rb").read(), False).decode()
            except (OSError, ValueError):
                return ""
        os.makedirs(os.path.dirname(arq), exist_ok=True)
        open(arq, "wb").write(dpapi(valor.encode(), True))
        return
    if valor is None:
        return subprocess.run(["security", "find-generic-password", "-a", "jfy", "-s", servico, "-w"],
                              capture_output=True, text=True).stdout.strip()
    esc = valor.replace("\\", "\\\\").replace('"', '\\"')
    subprocess.run(["security", "-i"], input=f'add-generic-password -U -a jfy -s {servico} -w "{esc}"\n',
                   text=True, check=True, capture_output=True)


def chaves_apagar(servico):
