def commit_fazer(pasta, mensagem, *arquivos):
    """Commita só os arquivos marcados, com as travas do committer: nada em main/master/develop nem fora do gitflow,
    nada no meio de merge ou rebase, varredura de segredos antes do git add, e nunca Co-Authored-By."""
    repo_do_jfy(pasta)
    branch = git(pasta, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if not BRANCH_OK.match(branch):
        sys.exit(f"O committer não commita em '{branch}': use uma branch feature/, bugfix/, hotfix/ ou release/.")
    gitdir = git(pasta, "rev-parse", "--git-dir").stdout.strip()
    if any(os.path.exists(os.path.join(pasta, gitdir, x)) for x in ("MERGE_HEAD", "rebase-merge", "rebase-apply", "CHERRY_PICK_HEAD")):
        sys.exit("Tem merge, rebase ou cherry-pick em andamento: termine antes de commitar.")
    mensagem = "\n".join(l for l in mensagem.strip().splitlines() if not re.match(r"(?i)co-authored-by:", l)).strip()
    if not arquivos or not mensagem:
        sys.exit("Marque os arquivos e escreva a mensagem.")
    existem = [a for a in arquivos if os.path.isfile(os.path.join(pasta, a))]
    achado = achar_segredos(pasta, existem)
    if achado:
        sys.exit("Possível segredo, commit parado:\n" + "\n".join(achado[:5]))
    r = git(pasta, "add", "-A", "--", *arquivos)
    if r.returncode:
        sys.exit(r.stderr.strip())
    arq = os.path.join(RUN_DIR, "commit-msg.txt")
    open(arq, "w").write(mensagem + "\n")
    r = git(pasta, "commit", "-F", arq, "--", *arquivos)
    if r.returncode:
        sys.exit((r.stderr or r.stdout).strip())
    return {"sha": git(pasta, "rev-parse", "--short", "HEAD").stdout.strip(), "assunto": mensagem.splitlines()[0]}


# ---------- fluxo de desenvolvimento na aba GitHub: histórico, branches, worktrees e abrir o PR ----------
def base_local(pasta, branch):
    """A base gitflow da branch nas refs locais (sem fetch): origin/develop, develop, origin/main… ou None."""
    nomes = ["main", "master"] if branch.startswith(("hotfix/", "release/")) else ["develop", "developer", "main", "master"]
    return next((r for n in nomes for r in (f"origin/{n}", n) if git(pasta, "rev-parse", "--verify", "--quiet", r).returncode == 0), None)


def repo_historico(pasta):
    """Os últimos 80 commits da branch atual, com as refs (branch, tag, origin) de cada um."""
    repo_do_jfy(pasta)
    linhas = git(pasta, "log", "-80", "--format=%h%x1f%s%x1f%an%x1f%cI%x1f%D").stdout.splitlines()
    return [dict(zip(("sha", "assunto", "autor", "quando", "refs"), l.split("\x1f"))) for l in linhas if l.count("\x1f") == 4]


def repo_commit(pasta, sha):
    """Um commit: a mensagem inteira, os arquivos (com o que aconteceu com cada um) e o diff, cortado em 4000 linhas."""
    repo_do_jfy(pasta)
    if not re.fullmatch(r"[0-9a-f]{4,40}", sha):
        sys.exit("Commit inválido.")
    nomes = [l.split("\t") for l in git(pasta, "-c", "core.quotePath=false", "show", "--format=", "--name-status", sha).stdout.splitlines() if l]
    return {"mensagem": git(pasta, "show", "-s", "--format=%B", sha).stdout.strip(),
            "arquivos": [{"estado": n[0][:1], "arquivo": n[-1]} for n in nomes],
            "diff": "\n".join(git(pasta, "-c", "core.quotePath=false", "show", "--format=", sha).stdout.splitlines()[:4000])}


def worktrees(pasta):
    """Os worktrees do repositório (o principal primeiro), com a branch e quantos arquivos mexidos cada um tem."""
    out, wt = [], {}
    for l in git(pasta, "worktree", "list", "--porcelain").stdout.splitlines() + [""]:
        if not l:
            if wt:
                caminho = wt["worktree"]
                out.append({"pasta": caminho, "branch": wt.get("branch", "").removeprefix("refs/heads/") or "(sem branch)",
                            "principal": not out, "orfao": "prunable" in wt or not os.path.isdir(caminho),
                            "mexidos": len(git(caminho, "status", "--porcelain").stdout.splitlines()) if os.path.isdir(caminho) else 0})
            wt = {}
        else:
            k, _, v = l.partition(" ")
            wt[k] = v
    return out


def repo_branches(pasta):
    """Branches locais (a mais mexida primeiro) com upstream, à frente e atrás, e se já entrou na base; e os worktrees."""
    repo_do_jfy(pasta)
    atual = git(pasta, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    base_ref = base_local(pasta, atual)
    entrou = set(git(pasta, "branch", "--format=%(refname:short)", "--merged", base_ref).stdout.split()) if base_ref else set()
    branches = []
    for l in git(pasta, "for-each-ref", "--sort=-committerdate",
                 "--format=%(refname:short)%1f%(upstream:short)%1f%(upstream:track)%1f%(committerdate:iso-strict)%1f%(subject)",
                 "refs/heads").stdout.splitlines():
        nome, up, track, quando, assunto = (l.split("\x1f") + [""] * 5)[:5]
        conta = lambda k: int((re.search(rf"{k} (\d+)", track) or [0, 0])[1])
        branches.append({"nome": nome, "atual": nome == atual, "upstream": up or None, "sumiu": "gone" in track,
                         "frente": conta("ahead"), "atras": conta("behind"), "quando": quando, "assunto": assunto,
                         "entrou": nome in entrou and nome not in ("main", "master", "develop")})
    lock = os.path.join(RUN_DIR, re.sub(r"\W", "_", pasta))
    return {"atual": atual, "base": base_ref, "task_rodando": ocupado(lock), "branches": branches, "worktrees": worktrees(pasta)}


def repo_branch(pasta, acao, *args):
    """trocar <nome>; criar <tipo> <título> (gitflow: feature e bugfix saem da develop atualizada, hotfix e release da
    main); excluir <nome> (só a que já entrou na base: git branch -d, nunca -D)."""
    repo_do_jfy(pasta)
    if acao in ("trocar", "criar") and ocupado(os.path.join(RUN_DIR, re.sub(r"\W", "_", pasta))):
        sys.exit("Tem uma task do jfy rodando neste repositório: trocar de branch agora mexe nos arquivos dela.")
    if acao == "trocar" and args:
        r = git(pasta, "switch", args[0])
    elif acao == "criar" and len(args) == 2 and args[0] in ("feature", "bugfix", "hotfix", "release") and slug(args[1]):
        r = git(pasta, "switch", "--no-track", "-c", f"{args[0]}/{slug(args[1])}", base(pasta, args[0]))
    elif acao == "excluir" and args:
        r = git(pasta, "branch", "-d", args[0])
    else:
        sys.exit("Use: trocar <branch>, criar <feature|bugfix|hotfix|release> <título> ou excluir <branch>.")
    if r.returncode:
        sys.exit((r.stderr or r.stdout).strip())


def worktree_acao(pasta, acao, wt=""):
    """abrir <worktree> (terminal livre do jfy nele), remover <worktree> (só sem mudança pendente) ou limpar (os órfãos)."""
    repo_do_jfy(pasta)
    lista = [w["pasta"] for w in worktrees(pasta) if not w["principal"]]
    if acao in ("abrir", "remover") and wt not in lista:
        sys.exit("Esse worktree não é deste repositório.")
    if acao == "abrir":
        return abrir_aba(os.path.basename(wt)[:20] + ": livre", wt, "--livre", wt)
    r = git(pasta, "worktree", "remove", wt) if acao == "remover" else git(pasta, "worktree", "prune") if acao == "limpar" else None
    if r is None:
        sys.exit("Use abrir, remover ou limpar.")
    if r.returncode:
        sys.exit((r.stderr or r.stdout).strip())


def pr_abrir(pasta):
    """"Abrir PR" da aba GitHub: numa aba do jfy, o Claude abre o PR da branch pelas regras do agente pr-creator (fora da
    pipeline: as tasks vêm das linhas Journify dos commits). Ele pede a sua aprovação antes de criar e de comentar."""
    repo_do_jfy(pasta)
    branch = git(pasta, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if not BRANCH_OK.match(branch):
        sys.exit(f"PR sai de uma branch feature/, bugfix/, hotfix/ ou release/; a atual é '{branch}'.")
    if not na_aba():
        return abrir_aba(f"PR: {os.path.basename(pasta)[:14]}", pasta, "--pr-abrir", pasta)
    pedido = (f"Abra o pull request da branch {branch} seguindo as regras do agente pr-creator, em ~/.claude/agents/pr-creator.md "
              "(leia o arquivo). Isto é fora da pipeline: não há .pipeline/, então pule as pré-condições que dependem dela. As tasks "
              "vêm das linhas 'Journify:' dos commits da branch (git log <base>..HEAD); o resto (template do repo, teto de 8 pontos, "
              "limite de 2 PRs por pessoa, plano de testes por critério da task, push sem --force) vale como lá. Mostre o título e o "
              "corpo e espere eu aprovar antes do gh pr create, e de novo antes de comentar o link nas tasks do Journify.")
    subprocess.call(["claude", *com_modelo("pr"), pedido], cwd=pasta, env=env_github(pasta))


def app(f, *a):
    """Roda um comando do app: o resultado em JSON no stdout; erro do Journify vira a mensagem, sem traceback."""
    try:
        r = f(*a)
    except (RuntimeError, urllib.error.URLError, OSError) as e:
        sys.exit(str(e))
    if r is not None:
        print(json.dumps(r, ensure_ascii=False))


