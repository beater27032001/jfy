# ---------- commit pelo app (aba GitHub): os arquivos que você marca, a mensagem pelas regras do committer ----------
COMMITTER = os.path.expanduser("~/.claude/agents/committer.md")
SEGREDO = (r"-----BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|sk_live_[0-9A-Za-z]+|sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{36}|"
           r"AIza[0-9A-Za-z_-]{35}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|"
           r"(password|senha|secret|token)[[:space:]]*[:=][[:space:]]*[\"'][^\"']{6,}")  # a varredura do committer
SEGREDO_RE = re.compile(SEGREDO.replace("[[:space:]]", r"\s"))  # o re do Python não tem as classes POSIX


def achar_segredos(pasta, arquivos):
    """A varredura do committer (era grep -nIE) em Python: o Windows não tem grep. Pula binário, como o -I.
    Devolve "arquivo:linha:texto" de cada achado."""
    achados = []
    for a in arquivos:
        try:
            dados = open(os.path.join(pasta, a), "rb").read()
        except OSError:
            continue
        if b"\0" in dados[:8000]:
            continue
        achados += [f"{a}:{n}:{l}" for n, l in enumerate(dados.decode("utf-8", "replace").splitlines(), 1) if SEGREDO_RE.search(l)]
    return achados


def repo_do_jfy(pasta):
    if pasta not in {r for _, r in pastas_projetos(load())}:
