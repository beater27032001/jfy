# ---------- corretor de português: o Claude (Haiku) do plano da pessoa, nos bastidores ----------
# Um Claude Code fica aberto em segundo plano (claude -p em stream-json): cada correção é só uma mensagem nova, sem abrir
# o Claude de novo (~1 a 2,5 s com o Haiku). Leve de propósito: sem ferramentas, sem MCP, sem os settings do usuário (nenhum
# hook roda, nenhum plugin carrega), um prompt curto no lugar do do Claude Code e sem salvar sessão nenhuma. O --bare
# seria mais rápido, mas só aceita chave de API, e aqui é o plano da pessoa. O texto nunca vai para disco.
CORRETOR = os.path.join(RUN_DIR, "corretor.json")  # porta, token e pid do servidor que está de pé
REGRAS_CORRECAO = ("Você corrige mensagens de trabalho (chat e email) em português do Brasil. Corrija só erros de ortografia, "
                   "acentuação, crase, concordância, pontuação e palavras confundidas (mas/mais, e/é, a/há). Não reescreva, não "
                   "troque palavras certas, não mude o tom, a ordem nem as quebras de linha e não acrescente nada. Mantenha "
                   "@menções, links, nomes, números e código exatamente como estão. Cada mensagem é independente das anteriores. "
                   "Devolva a mensagem corrigida no campo texto.")
ESQUEMA_CORRECAO = '{"type":"object","properties":{"texto":{"type":"string"}},"required":["texto"]}'
PROTEGIDO = re.compile(r"@\S+|https?://\S+|www\.\S+|`[^`]*`|\d+")


def trocas_correcao(orig, novo):
    """As palavras que a correção trocou, [{de, para}], ou None se ela não serve: mexeu em @menção, link, número ou código,
    mudou as quebras de linha ou trocou palavras demais (cara de reescrita, não de correção). A conta de "demais" é sem
    acento, sem maiúscula e sem pontuação: "reuniao" → "reunião" e "a" → "à" não contam como palavra trocada."""
    import difflib
    if novo is None or not novo.strip():
        return None
    if sorted(PROTEGIDO.findall(orig)) != sorted(PROTEGIDO.findall(novo)) or orig.count("\n") != novo.count("\n"):
        return None
    norm = lambda w: re.sub(r"[^\w]", "", unicodedata.normalize("NFD", w.lower()).encode("ascii", "ignore").decode())
    a, b = orig.split(), novo.split()
    if abs(len(a) - len(b)) > max(2, len(a) // 4) or difflib.SequenceMatcher(a=[norm(x) for x in a], b=[norm(x) for x in b],
                                                                              autojunk=False).ratio() < 0.6:
        return None
    sm = difflib.SequenceMatcher(a=a, b=b, autojunk=False)
    return [{"de": " ".join(a[i1:i2]), "para": " ".join(b[j1:j2])} for op, i1, i2, j1, j2 in sm.get_opcodes() if op != "equal"]


def corretor_servidor():
    """jfy --corretor-servidor (o --corrigir sobe sozinho, em segundo plano): HTTP em 127.0.0.1 com token, um Claude aberto
    corrigindo um texto por vez. Recomeça o Claude a cada 15 correções (cada mensagem carrega as anteriores) e sai depois
    de 10 min sem uso. O que já foi corrigido fica só na memória dele, para o mesmo texto não ir duas vezes."""
    import http.server, secrets, threading
    pasta = os.path.join(RUN_DIR, "corretor")  # vazia: nenhum CLAUDE.md de projeto entra
    os.makedirs(pasta, exist_ok=True)
    st, trava, cache = {"proc": None, "n": 0, "uso": time.time()}, threading.Lock(), {}

    def fechar():
        if st["proc"] and st["proc"].poll() is None:
            st["proc"].kill()
        st["proc"] = None

    def abrir():
        if st["proc"] is None or st["proc"].poll() is not None or st["n"] >= 15:
            fechar()
            st["n"] = 0
            st["proc"] = subprocess.Popen(
                ["claude", "-p", *com_modelo("correcao"), "--tools", "", "--strict-mcp-config", "--setting-sources", "project",
                 "--disable-slash-commands", "--no-session-persistence", "--input-format", "stream-json",
                 "--output-format", "stream-json", "--verbose", "--json-schema", ESQUEMA_CORRECAO, "--system-prompt", REGRAS_CORRECAO],
                cwd=pasta, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, encoding="utf-8",
                bufsize=1, env=dict(os.environ, JFY_SEM_AVISO="1"), **({"creationflags": 0x08000000} if WIN else {}))

    def perguntar(texto):
        abrir()
        p, resp = st["proc"], {}

        def ler():
            p.stdin.write(json.dumps({"type": "user", "message": {"role": "user", "content": texto}}) + "\n")
            p.stdin.flush()
            for linha in p.stdout:
                m = json.loads(linha)
                if m.get("type") == "result":
                    resp.update(m)
                    return
        t = threading.Thread(target=ler, daemon=True)
        t.start()
        t.join(25)
        if not resp:  # travou, fechou ou o plano recusou: o próximo pedido abre um Claude novo
            fechar()
            raise RuntimeError("o Claude não respondeu a correção")
        st["n"] += 1
        if resp.get("is_error") or resp.get("subtype") != "success":
            raise RuntimeError(str(resp.get("result") or "o Claude não corrigiu")[:200])
        return (resp.get("structured_output") or {}).get("texto")

    class Pedido(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass  # nada do texto vai para log

        def do_POST(self):
            if self.headers.get("Authorization") != f"Bearer {token}":
                return self.responder(401, {"erro": "token"})
            corpo = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            st["uso"] = time.time()
            try:
                with trava:
                    if self.path == "/aquecer":
                        abrir()
                        return self.responder(200, {"ok": True})
                    orig = corpo.get("texto") or ""
                    if orig not in cache:
                        # só o miolo vai para o Claude: ele não devolve a quebra de linha do fim (os apps mandam o texto
                        # com uma), e a trava das quebras descartava tudo. As pontas voltam como vieram
                        miolo = orig.strip()
                        antes, depois = orig[:len(orig) - len(orig.lstrip())], orig[len(orig.rstrip()):]
                        novo = perguntar(miolo)
                        trocas = trocas_correcao(miolo, novo)
                        cache[orig] = ({"texto": antes + novo.strip() + depois, "trocas": trocas} if trocas is not None
                                       else {"texto": orig, "trocas": [], "descartada": True})
                        if len(cache) > 300:
                            cache.pop(next(iter(cache)))
                    return self.responder(200, cache[orig])
            except Exception as e:
                return self.responder(500, {"erro": str(e)[:200]})

        def responder(self, cod, d):
            dados = json.dumps(d, ensure_ascii=False).encode()
            self.send_response(cod)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(dados)))
            self.end_headers()
            self.wfile.write(dados)

    token = secrets.token_hex(16)
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Pedido)
    json.dump({"porta": srv.server_port, "token": token, "pid": os.getpid()}, open(CORRETOR, "w"))

    def ocioso():
        while time.time() - st["uso"] < 600:
            time.sleep(15)
        fechar()
        srv.shutdown()
    threading.Thread(target=ocioso, daemon=True).start()
    srv.serve_forever()
    with contextlib.suppress(OSError, ValueError):
        if json.load(open(CORRETOR)).get("pid") == os.getpid():
            os.remove(CORRETOR)


def corretor_chamar(rota, dados=None, espera=30):
    """Fala com o servidor do corretor; se ele não está de pé, sobe em segundo plano e tenta de novo."""
    for tentativa in range(2):
        try:
            info = json.load(open(CORRETOR))
            req = urllib.request.Request(f"http://127.0.0.1:{info['porta']}/{rota}", json.dumps(dados or {}).encode(),
                                         {"Authorization": f"Bearer {info['token']}", "Content-Type": "application/json"})
            with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=espera) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:  # o servidor respondeu com o erro (o Claude não corrigiu)
            sys.exit(json.loads(e.read() or b"{}").get("erro") or f"o corretor recusou ({e.code})")
        except (OSError, ValueError, KeyError):
            if tentativa:
                sys.exit("O corretor não abriu. Tente de novo em instantes.")
            with contextlib.suppress(OSError):
                os.remove(CORRETOR)
            subprocess.Popen([*EU, "--corretor-servidor"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=open(os.path.join(RUN_DIR, "corretor.log"), "a"), **FUNDO)
            for _ in range(50):  # o servidor sobe em menos de 1 s; o Claude dele abre na primeira correção
                time.sleep(0.1)
                if os.path.exists(CORRETOR):
                    break


