    try:
        titulo, linhas = resumo_dia()
    except Exception as e:
        return notificar("jfy", f"Não consegui montar o resumo do dia: {e}")
    limpo = [" ".join(re.sub(r"\033\[[0-9;]*m", "", l).split()) for l in linhas]
    notificar("jfy: " + titulo, "\n".join(limpo[:4]) or "Sem reunião nem prazo hoje.")


def entrar():
