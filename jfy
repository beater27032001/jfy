def http_json(url, dados=None, token=None, corpo=None, metodo=None):
    """GET, POST de formulário (dados) ou de JSON (corpo) no Google; erro HTTP vira mensagem com o motivo (API
    desligada, escopo negado...). Resposta vazia (204) vira {}."""
    cab = {"Authorization": "Bearer " + token} if token else {}
    if corpo is not None:
        cab["Content-Type"] = "application/json"
    req = urllib.request.Request(url, json.dumps(corpo).encode() if corpo is not None
                                 else dados and urllib.parse.urlencode(dados).encode(), cab, method=metodo)  # PATCH, DELETE
    try:
        r = urllib.request.urlopen(req, timeout=20).read()
        return json.loads(r) if r else {}
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"Google {e.code}: {e.read().decode(errors='replace')[:300]}") from None


def google_token():
    """Access token (vale 1h), reaproveitado do Chaves até 5min antes de vencer; depois renova com o refresh
    token que o jfy --login guardou."""
    try:
        t = json.loads(chaves("jfy-google-acesso"))
        if t["expira"] - time.time() > 300:
            return t["token"]
    except (ValueError, KeyError, TypeError):
        pass
    cli, rt = load().get("google"), chaves("jfy-google")
    if not cli or not rt:
        raise RuntimeError("Google não conectado: rode jfy --login")
    r = http_json(TOKEN_URL, dict(cli, refresh_token=rt, grant_type="refresh_token"))
    chaves("jfy-google-acesso", json.dumps({"token": r["access_token"], "expira": time.time() + r.get("expires_in", 3600)}))
    return r["access_token"]


