# ---------- execução de uma task (roda na própria aba do tmux) ----------
def ocupado(lock):
    try:
        pid = int(open(lock).read())
        return vivo(pid) and pid != os.getpid()
    except (OSError, ValueError):
        return False


def base(repo, tipo="feature"):
    """Ponto de partida gitflow, atualizado do remoto: develop; hotfix sai da main. Sem develop, main/master."""
    git(repo, "fetch", "-q", "origin")
    for n in (["main", "master"] if tipo == "hotfix" else ["develop", "developer", "main", "master"]):  # developer: o do okra
        for ref in (f"origin/{n}", n):
            if git(repo, "rev-parse", "--verify", "--quiet", ref).returncode == 0:
                return ref
    return "HEAD"


def pontos(tk):
    return (tk.get("estimate") or {}).get("value") or 0


def tasks_da_branch(repo, atual):
    """Ids das tasks já commitadas na branch: as linhas 'Journify: <id>' que o committer da pipeline põe nos commits."""
    log = git(repo, "log", base(repo, atual.split("/")[0]) + "..HEAD", "--format=%(trailers:key=Journify,valueonly)")
    return list(dict.fromkeys(log.stdout.split()))


def garantir_branch(repo, task, tipo=None):
    """Branch gitflow para a task. Se a branch atual já é gitflow mas a task passaria o teto de pontos do PR, oferece outra.
    Devolve o tipo escolhido, para o próximo repo da mesma task não perguntar de novo."""
    atual = git(repo, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if not atual:
        return tipo
    pts = pontos(task)
    if BRANCH_OK.match(atual):
        if pts > TETO_PR:  # ponytail: sozinha não cabe em branch nenhuma; a tela da task e a /pipeline pedem para dividir
            return tipo
        feitas = []
        for i in tasks_da_branch(repo, atual):
            if i != task["id"]:
                try:
                    feitas.append(mcp("obter_task", taskId=i)["task"])
                except Exception:
                    pass  # task apagada ou sem acesso: não conta
        total = pts + sum(map(pontos, feitas))
        if total <= TETO_PR:
            return tipo
        print(c(f"{os.path.basename(repo)}: a branch {atual} já tem {total - pts:g} de {TETO_PR} pontos. "
                f"Com esta task ({pts:g}) passa do teto do PR:", 203))
        for t in feitas:
            print(dim(f"  {pontos(t):g} pts  {t['title']}"))
        msg = "Abra o PR dela e comece esta task numa branch nova:"
    else:
        msg = f"{os.path.basename(repo)}: branch atual '{atual}' não é gitflow. Criar a branch da task:"
    if not tipo:
        op = escolha(f"{msg}\n  1 feature  2 bugfix  (saem da develop atualizada)   3 hotfix (sai da main)   0 não criar\n> [1] ", "123") or "1"
        tipo = {"0": "nenhum", "2": "bugfix", "3": "hotfix"}.get(op, "feature")
    if tipo == "nenhum":
        return tipo
    nova = f"{tipo}/{slug(task['title'])}"
    if git(repo, "switch", nova).returncode != 0:
        subprocess.run(["git", "switch", "--no-track", "-c", nova, base(repo, tipo)], cwd=repo)
    return tipo


def criar_worktree(repo, titulo):
    # ponytail: worktree só quando o repo já tem outra task rodando; deps (node_modules, venv) não vêm junto
    branch = "feature/" + slug(titulo)
    wt = os.path.join(WT_DIR, os.path.basename(repo) + "-" + slug(titulo))
    if not os.path.isdir(wt):
        if git(repo, "worktree", "add", "--no-track", "-b", branch, wt, base(repo)).returncode != 0:
            subprocess.run(["git", "worktree", "add", wt, branch], cwd=repo, check=True)
        for f in os.listdir(repo):
            if f.startswith(".env") and os.path.isfile(os.path.join(repo, f)):
                shutil.copy2(os.path.join(repo, f), wt)
    print(c(f"Repo ocupado por outra task: usando worktree {wt} ({branch})", 214))
    return wt


