def mudancas(pasta):
    """[(estado, arquivo)] do git status, um arquivo por linha (pastas novas abertas), como o GitHub Desktop."""
    out, campos = [], git(pasta, "status", "--porcelain=v1", "-z", "-uall").stdout.split("\0")
    i = 0
    while i < len(campos) and campos[i]:
        x = campos[i]
        estado, arq = x[:2], x[3:]
        if "R" in estado or "C" in estado:
            i += 1  # renomeado: o caminho antigo vem no campo seguinte
        out.append((estado.strip() or "?", arq))
        i += 1
    return out


def repo_mudancas(pasta):
    """Aba GitHub > Alterações: os arquivos mexidos, a branch e se o committer aceita commitar nela."""
    repo_do_jfy(pasta)
    branch = git(pasta, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    return {"branch": branch, "gitflow": bool(BRANCH_OK.match(branch)),
            "arquivos": [{"estado": e, "arquivo": a} for e, a in mudancas(pasta)]}


def repo_diff(pasta, arquivo):
