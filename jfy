def projeto_salvar(dados):
    """Grava o projeto como o configurar() do terminal: {"id", "nome" (o apelido no jfy), "pastas": [...]}. Sem pasta,
    é um projeto sem repositório (estudo, documentos): o Claude abre numa pasta só dele."""
    d = json.loads(dados)
    pid, nome = id_projeto(d.get("id")), (d.get("nome") or "").strip()
    if not pid:
        sys.exit("Escolha o projeto do Journify.")
    if not nome:
        sys.exit("Dê um nome curto ao projeto (é como ele aparece no jfy).")
    cfg = load()
    if any(k != pid and p["nome"].lower() == nome.lower() for k, p in cfg["projetos"].items()):
        sys.exit(f"Já existe um projeto chamado {nome} no jfy.")
    pastas = list(dict.fromkeys(os.path.realpath(os.path.expanduser(x)) for x in d.get("pastas") or [] if x.strip()))
    for x in pastas:
        if not os.path.isdir(x):
            sys.exit(f"A pasta {x} não existe.")
    if not pastas:
        pastas = [os.path.join(SEM_REPO, pid)]
        os.makedirs(pastas[0], exist_ok=True)
    conta = (d.get("github") or "").strip()
    if conta and conta not in contas_gh()[1]:
        sys.exit(f"A conta {conta} não está no gh deste Mac: adicione em Configurações › GitHub.")
    if conta:  # antes de gravar: conta sem token não fica salva pela metade
        ident = identidade_github(conta)
        # ponytail: pasta que ainda não é repositório fica de fora; salve o projeto de novo depois do clone ou git init
        for x in pastas:
            if git(x, "rev-parse", "--git-dir").returncode == 0:
                conta_no_repo(x, conta, ident)
    cfg["projetos"][pid] = {"nome": nome, "repo": pastas[0], "repos": pastas, **({"github": conta} if conta else {})}
    save(cfg)
    return {"id": pid, "nome": nome, "pastas": pastas}


def token_github(login):
    """O token de uma conta do gh, sem trocar a conta ativa (que vale para o Mac todo)."""
    return subprocess.run(["gh", "auth", "token", "-h", "github.com", "-u", login], capture_output=True, text=True).stdout.strip()


def identidade_github(login):
    """(nome, email) dos commits de uma conta: o nome e o email públicos dela ou, sem email público, o noreply do
    GitHub (o commit aparece como dela do mesmo jeito)."""
    tok = token_github(login)
    if not tok:
        sys.exit(f"Não achei o token da conta {login} no gh: entre de novo nela em Configurações › GitHub.")
    r = subprocess.run(["gh", "api", "user"], capture_output=True, text=True, env=dict(os.environ, GH_TOKEN=tok))
    if r.returncode:
        sys.exit(f"O GitHub não respondeu pela conta {login}: {(r.stderr or r.stdout).strip()[:200]}")
    u = json.loads(r.stdout)
    return (u.get("name") or "").strip() or login, u.get("email") or f"{u['id']}+{login}@users.noreply.github.com"


def conta_no_repo(pasta, login, ident):
    """Prende o repositório a uma conta do GitHub, na config dele (vale para as worktrees também): os commits saem com
    o nome e o email dela e o push usa o token dela, seja qual for a conta ativa do gh. O helper do gh não serve:
    ele só entrega o token da conta ativa."""
    if not re.fullmatch(r"[A-Za-z0-9-]+", login):
        sys.exit(f"Conta do GitHub inválida: {login}")
    chave, gh_bin = "credential.https://github.com.helper", shlex.quote(shutil.which("gh") or "gh")
    git(pasta, "config", "--local", "--unset-all", chave)
    for k, v in (("user.name", ident[0]), ("user.email", ident[1]), ("jfy.github", login), (chave, "")):  # "" zera os helpers globais
        git(pasta, "config", "--local", "--add" if k == chave else "--replace-all", k, v)
    git(pasta, "config", "--local", "--add", chave,
        f'!f() {{ test "$1" = get || return 0; echo username={login}; echo "password=$({gh_bin} auth token -h github.com -u {login})"; }}; f')


def env_github(pasta):
    """O ambiente do Claude numa pasta de projeto com conta do GitHub: o GH_TOKEN dela, para o gh (gh pr create da
    pipeline) usar a conta do projeto e não a ativa. None: herda o ambiente."""
    login = git(pasta, "config", "jfy.github").stdout.strip() if os.path.isdir(pasta) else ""
    tok = login and token_github(login)
    return dict(os.environ, GH_TOKEN=tok) if tok else None


