def arquivos_json(pid, forcar=""):
    """Aba Arquivos do projeto: o Drive do projeto, os anexos das tasks e os documentos que são arquivo, numa chamada
    só (listar_arquivos), os mais novos primeiro. `forcar` ficou só por compatibilidade: não há mais o que guardar."""
    lista = mcp("listar_arquivos", projetoId=pid)
    out = [{"id": a.get("link") or f"{a.get('taskId')}|{a.get('nome')}|{n}", "nome": a.get("nome") or "arquivo", "url": a.get("link"),
            "tipo": a.get("tipo") or "", "tamanho": a.get("tamanho") if isinstance(a.get("tamanho"), (int, float)) else None,
            "por": a.get("enviadoPor"), "quando": a.get("data"), "task": a.get("taskId"), "task_titulo": a.get("taskTitulo"),
            "origem": a.get("origem"),  # drive, task ou documento
            "categoria": CAT_ARQUIVO.get(a.get("categoria")) or categoria_arquivo(a.get("nome"), a.get("tipo"))}
           for n, a in enumerate(lista)]
    tasks = len({a["task"] for a in out if a["task"]})
