def horas_nova(dia, projeto, categoria, horas, descricao):
    """Aba Horas do app: um trabalho registrado à mão (jfy --horas-nova <dia> <projeto> <categoria> <horas> <descrição>).
    Vai para o mesmo log em que o jfy grava as tasks e o terminal livre, então vira uma linha como as outras: editar,
    levar para outro dia, remover e lançar no Journify. As horas são o trabalhado; a regra (fator) vale em cima, como
    nas outras linhas de trabalho. Projeto: o id do jfy ou um nome livre, como no menu da tabela."""
    d, m = date.fromisoformat(dia), ler_minutos(horas or "")
    if d > date.today():
        sys.exit("Horas só para hoje ou para um dia que já passou.")
    if not m:
        sys.exit(f"Não entendi as horas '{horas}': use 1:20, 1h20, 80 (minutos) ou 1,5 (horas).")
    if not projeto.strip() or not categoria.strip() or not descricao.strip():
        sys.exit("Escolha o projeto e a categoria e escreva a descrição.")
    ini = datetime(d.year, d.month, d.day, 12).timestamp()  # meio-dia: o registro cai no dia certo em qualquer fuso
    registrar_horas(ini, ini + m * 60, m, "manual", pid=projeto.strip(), titulo=descricao.strip(), cat=categoria.strip())
    return {"dia": d.isoformat(), "trabalhado": m}


def mover_horas(dia, kid, novo):
    """Leva uma linha das horas (task, terminal livre, preparação de reunião) para outro dia, com os ajustes dela. O
    trabalhado não muda: se o outro dia já tem a mesma linha, os dois somam. Reunião fica no dia da agenda. Guarda os
    quatro arquivos antes e confere a soma do trabalhado dos dois dias depois: se não fechar, volta tudo como estava."""
    cfg, d1, d2 = load(), date.fromisoformat(dia), date.fromisoformat(novo)
    if d2 == d1:
        return
    if d2 > date.today():
        sys.exit("Só dá para levar para hoje ou para um dia que já passou.")
    trabalhado = lambda it: it["med"] if it["fixo"] is None else it["fixo"]
    total = lambda d: sum(trabalhado(x) for x in itens_horas(cfg, d)[0] if not x["fora"])
    with contextlib.redirect_stdout(sys.stderr):  # aviso de agenda fora não suja o JSON do app
        it = next((x for x in itens_horas(cfg, d1)[0] if x["kid"] == kid and not x["fora"]), None)
        if not it:
            sys.exit("Essa linha não existe mais nesse dia.")
        if it["reuniao"]:
            sys.exit("Reunião fica no dia em que aconteceu, pela agenda. Para tirar dela daqui, remova a linha.")
        alvo = next((x for x in itens_horas(cfg, d2)[0] if x["kid"] == kid), None)
        if alvo and alvo["fora"]:
            sys.exit(f"Em {d2.strftime('%d/%m')} essa mesma linha está removida: restaure ela lá antes de juntar.")
        antes = total(d1) + total(d2)
    log1, log2 = (os.path.join(HORAS_DIR, d.isoformat() + ".jsonl") for d in (d1, d2))
    aj1, aj2 = ajustes_arq(d1), ajustes_arq(d2)
    copia = {a: open(a).read() if os.path.exists(a) else None for a in (log1, log2, aj1, aj2)}
    try:
        entradas = entradas_do_log(d1)
        da_linha = lambda k: "|".join(str(x) for x in k) == kid
        desloca = (d2 - d1).days * 86400  # o registro passa a ter o horário no dia novo
        vai = [dict(e, ini=e["ini"] + desloca, fim=e["fim"] + desloca) for e, k in entradas if da_linha(k)]
        fica = [e for e, k in entradas if not da_linha(k)]
        with open(log2, "a") as f:  # primeiro grava no dia novo: se algo quebrar no meio, sobra, não some
            f.writelines(json.dumps(e, ensure_ascii=False) + "\n" for e in vai)
        with open(log1, "w") as f:
            f.writelines(json.dumps(e, ensure_ascii=False) + "\n" for e in fica)
        ler = lambda a: json.load(open(a)) if os.path.exists(a) else {}
        a1, a2 = ler(aj1), ler(aj2)
        meu = a1.pop(kid, {})
        if alvo:  # o dia novo já tinha a linha: valem projeto, categoria e descrição de lá, e o trabalhado soma
            junta = {k: v for k, v in a2.get(kid, {}).items() if k != "min"}
            if alvo["fixo"] is not None or it["fixo"] is not None:
                junta["min"] = trabalhado(alvo) + trabalhado(it)
            if junta:
                a2[kid] = junta
        elif meu:
            a2[kid] = meu
        json.dump(a1, open(aj1, "w"), indent=1, ensure_ascii=False)
        json.dump(a2, open(aj2, "w"), indent=1, ensure_ascii=False)
        with contextlib.redirect_stdout(sys.stderr):
            depois = total(d1) + total(d2)
        if depois != antes:
            raise RuntimeError(f"a soma do trabalhado mudou ({antes} → {depois} min)")
    except Exception as erro:
        for a, txt in copia.items():  # volta tudo como estava
            if txt is None:
                if os.path.exists(a):
                    os.remove(a)
            else:
                open(a, "w").write(txt)
        sys.exit(f"Não mudei o dia: {erro}. Nada mudou.")
    return {"para": d2.isoformat(), "trabalhado": trabalhado(it), "juntou": bool(alvo)}


def lancamentos_do_dia(dia):
    """Os lançamentos de horas do dia no Journify (listar_horas)."""
    return mcp("listar_horas", de=dia.isoformat(), ate=dia.isoformat()).get("lancamentos") or []


# um lançamento do listar_horas vem com os nomes em inglês: id, date, projectId, projectName, stageId, taskId,
# category, activity, regularHours, overtimeHours
def lanc_horas(l):
    return float(pega(l, "regularHours", "horas", "hours") or 0)


def casar_lancamentos(cfg, itens, ja):
    """Cada linha viva com o lançamento do Journify que é ela (mesmo projeto e mesma descrição), ou None. Devolve
    ({kid: lançamento ou None}, os lançamentos do dia que não são de linha nenhuma)."""
    norm = lambda t: " ".join(str(t or "").lower().split())
    livres, par = list(ja), {}
    for it in itens:
        pj = projeto_journify(cfg, it["p"])
        l = next((x for x in livres if pj and pega(x, "projectId", "projetoId") == pj["id"]
                  and norm(pega(x, "activity", "atividade", "descricao")) == norm(it["desc"])), None)
        if l:
            livres.remove(l)
        par[it["kid"]] = l
    return par, livres


def estado_journify(cfg, dia, itens):
    """(resumo do dia no Journify ou None, {kid: "lancada" | "mudou" | "nova"}) para a aba Horas, lido do próprio
    Journify: o que foi lançado por qualquer caminho (o app, o jfy, outra pessoa corrigindo) conta."""
    ja = lancamentos_do_dia(dia)
    if not ja:
        return None, {}
    vivos = [it for it in itens if not it["fora"]]
    par, sobra = casar_lancamentos(cfg, vivos, ja)
    igual = lambda l, it: abs(lanc_horas(l) - it["lanc"] / 60) < 0.01 and pega(l, "category", "categoria") == it["cat"]
    estado = {it["kid"]: "nova" if not par[it["kid"]] else "lancada" if igual(par[it["kid"]], it) else "mudou" for it in vivos}
    return {"lancamentos": len(ja), "horas": round(sum(map(lanc_horas, ja)), 2), "removidas": len(sobra)}, estado


def etapa_padrao(pj, cat):
    """A etapa do projeto para uma linha: a única que ele tem; senão a de Design para as categorias de design e a de
    Desenvolvimento para as outras. ponytail: pelo nome da etapa; projeto com etapas de outros nomes vai sem etapa."""
    es = pj.get("etapas") or []
    if len(es) == 1:
        return es[0]["id"]
    quer = "design" if cat in ("Design", "UI/UX", "Wireframe", "Protótipo", "Ilustração", "Branding") else "desenvolvimento"
    return next((e["id"] for e in es if e["nome"].lower().startswith(quer)), None)


def tasks_das_linhas(dia):
    """{linha: task} das linhas que vão ligadas a uma task no Journify: as que vieram de uma task só, e todas com o
    "ligar" que você escolheu ao encerrar (sem ele, a linha vai solta, só com o projeto)."""
    por = {}
    for e, k in entradas_do_log(dia):
        por.setdefault("|".join(str(x) for x in k), set()).add(e.get("tid") if e.get("ligar") else None)
    return {kid: next(iter(t)) for kid, t in por.items() if len(t) == 1 and None not in t}


def horas_lancar(dia):
    """O "Lançar no Journify" da aba Horas, direto pelo MCP (sem o Claude e sem o Chrome): a linha que já está lá (mesmo
    projeto e descrição) é editada se mudou; as outras entram juntas, tudo ou nada (20 por chamada). A linha de uma task
    vai ligada à task. Lançamento do dia que não é de linha nenhuma fica como está (o MCP não apaga): volta em
    "sobrando", para você ver."""
    cfg, d = load(), date.fromisoformat(dia)
    with contextlib.redirect_stdout(sys.stderr):  # aviso de agenda fora não suja o JSON do app
        itens = [it for it in itens_horas(cfg, d)[0] if not it["fora"] and it["lanc"] > 0]
    if not itens:
        sys.exit("Nada para lançar nesse dia.")
    sem = [it["desc"] for it in itens if not projeto_journify(cfg, it["p"])]
    if sem:
        sys.exit("Escolha o projeto do Journify destas linhas antes de lançar: " + "; ".join(sem[:5]) + ".")
    cats = set(projetos_journify()["categorias"])
    fora = [f"{it['desc']} ({it['cat']})" for it in itens if cats and it["cat"] not in cats]
    if fora:
        sys.exit("Categoria que o Journify não tem: " + "; ".join(fora[:5]) + ". Troque na coluna Categoria.")
    par, sobra = casar_lancamentos(cfg, itens, lancamentos_do_dia(d))
    tarefas, novas, editadas, iguais = tasks_das_linhas(d), [], 0, 0
    for it in itens:
        pj, h, l = projeto_journify(cfg, it["p"]), round(it["lanc"] / 60, 2), par[it["kid"]]
        if l:
            if abs(lanc_horas(l) - h) < 0.01 and pega(l, "category", "categoria") == it["cat"]:
                iguais += 1
            else:
                mcp("editar_horas", lancamentoId=pega(l, "id", "lancamentoId"), horas=h, categoria=it["cat"])
                editadas += 1
            continue
        linha = {"data": d.isoformat(), "projetoId": pj["id"], "horas": h, "categoria": it["cat"], "atividade": it["desc"][:2000]}
        if tarefas.get(it["kid"]):
            linha["taskId"] = tarefas[it["kid"]]
        if etapa_padrao(pj, it["cat"]):
            linha["etapaId"] = etapa_padrao(pj, it["cat"])
        novas.append(linha)
    for i in range(0, len(novas), 20):
        mcp("lancar_horas", lancamentos=novas[i:i + 20])
    return {"novas": len(novas), "editadas": editadas, "iguais": iguais,
            "sobrando": [{"projeto": pega(l, "projectName", "projectId", "projeto"), "atividade": pega(l, "activity", "atividade"),
                          "horas": lanc_horas(l)} for l in sobra]}


