        r = subprocess.run(["git", "-c", "core.quotePath=false", "diff", "--no-index", "--", "/dev/null", arquivo], cwd=pasta,
                           capture_output=True, text=True)
    else:
        r = git(pasta, "-c", "core.quotePath=false", "diff", "HEAD", "--", arquivo)
    return {"diff": "\n".join(r.stdout.splitlines()[:4000]) or "(sem diferença de texto: arquivo binário ou só permissão)"}


def identidade(pasta):
    """(conta compartilhada?, nome para o prefixo) pela regra do committer: user.name ou user.email do repo com
    atom.?studio.?ferramentas; o nome sai do git config --global pipeline.commitAuthor."""
    quem = git(pasta, "config", "user.name").stdout + " " + git(pasta, "config", "user.email").stdout
    return bool(re.search(r"atom.?studio.?ferramentas", quem, re.I)), git(pasta, "config", "--global", "pipeline.commitAuthor").stdout.strip()


def commit_mensagem(pasta, *arquivos):
    """A mensagem do commit dos arquivos marcados, pelas regras do agente committer (lidas do committer.md: mudar o
    agente muda aqui). Vai para o Claude só o diff desses arquivos; ele roda sem ferramentas, no modelo do agente."""
    repo_do_jfy(pasta)
    if not arquivos:
        sys.exit("Marque os arquivos do commit.")
    try:
        agente = open(COMMITTER).read()
    except OSError:
        sys.exit("Não achei o agente committer em ~/.claude/agents (rode o ./install.sh do jfy).")
    regras = agente[agente.find("### 5. Message format"):agente.find("### 6. Commit")]
    # o escolhido no app vale; sem escolha, o modelo do agente committer (e o Sonnet, se ele não disser)
    modelo = (modelo_de("commit") if load().get("modelos", {}).get("commit")
              else (re.search(r"(?m)^model:\s*(\S+)", agente) or [None, "sonnet"])[1])
    compartilhada, nome = identidade(pasta)
    if compartilhada and not nome:
        sys.exit("NOME: conta compartilhada sem nome salvo: diga o seu nome para o prefixo dos commits.")
    branch = git(pasta, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    tasks = tasks_commitadas(pasta, branch)
    diff = "\n".join(repo_diff(pasta, a)["diff"] for a in arquivos)[:30000]
    pedido = (f"Você é o committer do time. Escreva UMA mensagem de commit para as mudanças abaixo, seguindo estas "
              f"regras do agente committer:\n\n{regras}\n"
              f"Dados: branch {branch}. " + (f"Conta compartilhada: o assunto começa com [{nome}]. " if compartilhada
                                              else "Não é a conta compartilhada: sem prefixo de nome. ")
              + (f"Tasks do Journify desta branch: {', '.join(tasks)} (uma linha 'Journify: <id>' para cada, no fim). "
                 if tasks else "Sem task do Journify: sem a linha Journify. ")
              + "Idioma: o dos commits recentes:\n" + git(pasta, "log", "-8", "--format=  %s").stdout
              + "\nDevolva só a mensagem (assunto, linha em branco, corpo opcional), sem comentário e sem cercas de código. "
              "Nunca ponha Co-Authored-By.\n\n<mudancas>\n" + diff + "\n</mudancas>")
    pasta_vazia = os.path.join(RUN_DIR, "commit-ia")
    os.makedirs(pasta_vazia, exist_ok=True)
    try:
        r = subprocess.run(["claude", "-p", *(["--model", modelo] if modelo else []), "--tools", "", "--", pedido], cwd=pasta_vazia, capture_output=True,
                           text=True, timeout=180, stdin=subprocess.DEVNULL, env=dict(os.environ, JFY_SEM_AVISO="1"))
    except subprocess.TimeoutExpired:
        sys.exit("O Claude demorou mais de 3 min. Tente de novo.")
    if r.returncode or not r.stdout.strip():
        sys.exit((r.stderr or r.stdout).strip() or "O Claude não devolveu a mensagem.")
    return {"mensagem": re.sub(r"^```\w*\n|\n```$", "", r.stdout.strip())}


def tasks_commitadas(pasta, branch):
    """Ids do Journify já commitados na branch (a linha 'Journify: <id>' do committer), desde a base gitflow local
    (sem fetch: o commit não espera a rede)."""
    base_ref = base_local(pasta, branch) if BRANCH_OK.match(branch) else None
    if not base_ref:
        return []
    return list(dict.fromkeys(git(pasta, "log", base_ref + "..HEAD", "--format=%(trailers:key=Journify,valueonly)").stdout.split()))


def commit_autor(nome):
