# seções da lista de tasks, na ordem do que pede ação sua primeiro; o status sai da linha porque a seção já diz
ETAPAS = ["URGENTE", "EM ANDAMENTO", "A FAZER", "ESPERANDO ALGUÉM", "BLOQUEADAS"]
ESPERA = {"em_revisao": "revisão", "em_teste": "teste", "pendente_validacao": "validação"}


def etapa(t):
    s = t["statusId"]
    return (0 if urgencia(t) is not None else 1 if s == "em_progresso" else 3 if s in ESPERA
            else 4 if s == "bloqueado" else 2)


def tela_projeto(cfg, pid):
    buscado = 0
    while True:
        if time.time() - buscado > 60:  # voltar de uma task não espera o Journify de novo; Enter força
            tasks = sorted(mcp("minhas_tasks", projetoId=pid),
                           key=lambda x: (etapa(x), urgencia(x) or 0,
                                          ORDEM.index(x["statusId"]) if x["statusId"] in ORDEM else len(ORDEM)))
            buscado = time.time()
        w = 12 if any(etapa(x) in (0, 3) or x.get("dueDate") for x in tasks) else 0
        itens, atual = [], None
        for x in tasks:
            if etapa(x) != atual:
                atual = etapa(x)
                itens.append((ETAPAS[atual],))
            col = c(ESPERA[x["statusId"]].ljust(w), 250) if atual == 3 else tag_prazo(x, w)
            st = ESPERA.get(x["statusId"]) or x["statusId"].replace("_", " ") if atual == 0 else ""
            tit = corta(x["title"], (shutil.get_terminal_size().columns or 100) - w - len(st) - 12)
            itens.append((f"{col}  " if w else "") + tit + (dim(f"  · {st}") if st else ""))
        nome = c(cfg["projetos"][pid]["nome"], cor_projeto(pid), True)
        op = menu(f"{nome} · minhas tasks ({len(tasks)})", itens or [(dim("nenhuma task sua neste projeto"),)],
                  [("s", "sessão (várias tasks num chat)"), ("l", "terminal livre"), ("c", "trocar repo"),
                   ("enter", "atualiza")], teclas="slc")
        if op == "0":
            return
        if op == "":
            buscado = 0
        if op == "c":
            configurar(cfg, pid)
        elif op == "l":
            abrir_aba(cfg["projetos"][pid]["nome"][:20] + ": livre", pid, "--livre", cfg["projetos"][pid]["repo"])
        elif op == "s":
            abrir_aba(cfg["projetos"][pid]["nome"][:20] + ": sessão", pid, "--sessao", pid)
        elif op.isdigit() and 1 <= int(op) <= len(tasks):
            tela_task(cfg, tasks[int(op) - 1])


def principal():
    tasks, buscado = [], 0
    while True:
        try:
            cfg = load()  # relê a cada volta: o config pode ter mudado fora deste menu
            cronometro("ligar")  # primeira vez no jfy hoje = início da jornada
            if time.time() - buscado > 60:  # voltar de um submenu não espera o Journify; Enter força
                tasks, buscado = mcp("minhas_tasks"), time.time()
            urgentes = foco(tasks)  # prazo vencido / nos próximos dias / crítica, de todos os projetos
            # configurados sem task aberta também aparecem (embaixo): manutenção às vezes pede um terminal livre ou sessão
            n_tasks = lambda p: sum(x["projectId"] == p for x in tasks)
            pids = sorted({x["projectId"] for x in tasks} | set(cfg["projetos"]),
                          key=lambda p: (not n_tasks(p), cfg["projetos"].get(p, {}).get("nome", "~" + p)))
            larg = shutil.get_terminal_size().columns or 100

            def linha_proj(p):
                pc, n = cfg["projetos"].get(p), n_tasks(p)
                qtd = dim(f"{n:>2} task{'s' if n != 1 else ''}") if n else ""
                if pc:
                    return c(pc["nome"][:12].ljust(12), cor_projeto(p), True) + " " + qtd
                exemplo = next((x["title"] for x in tasks if x["projectId"] == p), "")  # o MCP não dá o nome do projeto
                return (dim(p[:8].ljust(12)) + " " + qtd + "  " + c("sem repo: escolha para configurar", 214)
                        + dim(f"  ex.: {corta(exemplo, 40)}"))
            com, sem = [p for p in pids if n_tasks(p)], [p for p in pids if not n_tasks(p)]  # = ordem de pids
            itens = (([("FOCO",)] + [linha_foco(cfg, t, larg) for t in urgentes] if urgentes else [])
                     + ([("PROJETOS",)] + [linha_proj(p) for p in com] if com else [])
                     + ([("SEM TASK", "manutenção: terminal livre ou sessão")] + [linha_proj(p) for p in sem] if sem else []))
            abas = int(subprocess.run(TMUX + ["display", "-p", "#{session_windows}"], capture_output=True, text=True).stdout.strip() or 1)
            dia = ["seg", "ter", "qua", "qui", "sex", "sáb", "dom"][date.today().weekday()] + date.today().strftime(" %d/%m")
            op = menu(f"jfy · {dia}" + (f" · {abas - 1} aba(s) aberta(s) na barra de baixo" if abas > 1 else ""), itens,
                      [("l", "terminal livre"), ("r", "reuniões"), ("h", "horas"), ("t", "tema"), ("enter", "atualiza")],
                      "sai", teclas="lrht")
            if op == "":  # Enter não sai mais: atualiza as tasks
                buscado = 0
                continue
            if op == "0":
                if abas > 1 and ask("Tasks ainda rodando. Sair e deixar elas rodando? Volte com 'jfy'. (s/n) ", "s") == "s":
                    subprocess.run(TMUX + ["detach-client"])
                    continue
                return
            if op == "t":
                tela_tema()
            if op == "r":
                tela_reunioes(cfg)
            if op == "h":
                abrir_aba("horas", "horas", "--horas")
            if op == "l":
                ultimo = next((os.path.dirname(x["repo"]) for x in cfg["projetos"].values()), os.path.expanduser("~/Documents"))
                pasta = escolher_pasta(ultimo)
                if pasta:
                    abrir_aba(os.path.basename(pasta)[:20] + ": livre", pasta, "--livre", pasta)
            k = int(op) if op.isdigit() else 0
            if 1 <= k <= len(urgentes):
                t = urgentes[k - 1]
                if t["projectId"] in cfg["projetos"] or configurar(cfg, t["projectId"]):
                    tela_task(cfg, t)
            elif 1 <= k - len(urgentes) <= len(pids):
                pid = pids[k - len(urgentes) - 1]
                if pid in cfg["projetos"] or configurar(cfg, pid):
                    tela_projeto(cfg, pid)
                buscado = 0  # mexeu num projeto (status, prazo, task nova): relê ao voltar
        except Exception as e:  # rede/Journify fora: mostra e volta ao menu
            ask(c(f"Erro: {e}. Enter para tentar de novo.", 203))


def main():
    a = sys.argv[1:]
    if a[:1] == ["--run"]:
        return rodar(*a[1:3])
    if a[:1] == ["--livre"]:
        return livre(a[1])
    if a[:1] == ["--sessao"]:
        return sessao(a[1])
    if a[:1] == ["--inicio"]:
        return inicio(a[1])
    if a[:1] == ["--relogio"]:
        return relogio()
    if a[:1] == ["--pausar"]:  # Ctrl-b p
        return cronometro("alternar")
    if a[:1] == ["--zerar"]:  # Ctrl-b r
        return cronometro("zerar")
    if a[:1] == ["--notificar"]:
        return notificar_dia()
    if a[:1] == ["--hoje"]:  # o dia sem abrir o menu
        titulo, linhas = resumo_dia()
        return print(c(titulo, 39, True) + "\n" + "\n".join(linhas))
    if a[:1] == ["--login"]:  # Google: agenda e Gmail
        return login()
    if a[:1] == ["--horas"]:  # jfy --horas [data]: tabela para o minhas-horas
        d = ler_data(a[1], futuro=False) if a[1:] else None
        if a[1:] and not d:
            return print(c(f"Data inválida: {a[1]}", 203))
        return tela_horas(date.fromisoformat(d) if d else None)  # sem data: hoje
    if a[:1] == ["--reuniao"]:
        return preparar(a[1])
    if a[:1] == ["--fechar"]:  # fechamento de uma task em segundo plano
        return fechar_agora(*a[1:5])
    if a[:1] == ["--email"]:  # clique no ✉ da barra
        return ler_emails()
    if a[:1] == ["--entrar"]:  # Ctrl-b m
        return entrar()
    if a[:1] == ["--atalhos"]:  # Ctrl-b c
        return atalhos()
    if a[:1] == ["--avisar"]:  # hook do Claude Code
        return avisar()
    if a[:1] == ["--fim"]:
        return fim(a[1], int(a[a.index("--min") + 1]) if "--min" in a else None, "--pronta" in a, "--nada" in a)
    if os.path.basename(os.environ.get("TMUX", "").split(",")[0]) == "jfy":
        return principal()
    # fora do tmux: entra (ou volta) na sessão jfy, garantindo a aba do menu
    tmux_conf()
    if subprocess.run(TMUX + ["has-session", "-t", "jfy"], capture_output=True).returncode == 0:
        abas = subprocess.run(TMUX + ["list-windows", "-t", "jfy", "-F", "#{window_name}"], capture_output=True, text=True).stdout.split("\n")
        if "menu" not in abas:
            subprocess.run(TMUX + ["new-window", "-t", "jfy:0", "-n", "menu", SELF])
        os.execvp("tmux", TMUX + ["attach", "-t", "jfy:menu"])
    os.execvp("tmux", TMUX + ["new-session", "-s", "jfy", "-n", "menu", SELF])


