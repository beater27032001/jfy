def modelo_do_agente(txt):
    m = re.search(r"(?m)^model:\s*(\S+)", txt or "")
    return m[1] if m else None


def com_modelo_no_agente(txt, modelo):
    """O arquivo do agente com a linha model: do cabeçalho trocada (ou posta), sem mexer em mais nada."""
    if re.search(r"(?m)^model:\s*\S+", txt):
        return re.sub(r"(?m)^model:\s*\S+", f"model: {modelo}", txt, count=1)
    return re.sub(r"\A---\n", f"---\nmodel: {modelo}\n", txt, count=1)


def modelo_oficial(agente):
    """O model: do agente na versão da pipeline oficial (o commit atual do clone), sem as trocas locais."""
    r = subprocess.run(["git", "-C", PIPE, "show", f"HEAD:agents/{agente}.md"], capture_output=True, text=True)
    return modelo_do_agente(r.stdout) if r.returncode == 0 else None


def gravar_modelo_agente(agente, modelo):
    arq = os.path.join(PIPE, "agents", f"{agente}.md")
    txt = open(arq).read()
    if modelo and modelo_do_agente(txt) != modelo:
        open(arq, "w").write(com_modelo_no_agente(txt, modelo))


def agentes_json():
    """Configurações do app: os agentes da pipeline, com o modelo de agora, o oficial e o que você escolheu."""
    if not os.path.isdir(os.path.join(PIPE, "agents")):
        return {"opcoes": OPCOES_AGENTE, "agentes": []}
    escolhas = load().get("modelos_agentes", {})
    out = []
    for nome in sorted(x for x in os.listdir(os.path.join(PIPE, "agents")) if x.endswith(".md")):
        a, txt = nome[:-3], open(os.path.join(PIPE, "agents", nome)).read()
        desc = re.search(r"(?m)^description:\s*(.+)$", txt)
        out.append({"id": a, "papel": PAPEL_AGENTE.get(a) or (desc[1].split(". ")[0] if desc else ""),
                    "modelo": escolhas.get(a, "oficial"), "atual": modelo_do_agente(txt), "oficial": modelo_oficial(a)})
    return {"opcoes": OPCOES_AGENTE, "agentes": out}


def agente_modelo(agente, valor):
    """Escolhe o modelo de um agente da pipeline: fica no config (a escolha volta depois de atualizar a pipeline) e vai
    para a linha model: do agente. "oficial" volta ao valor da pipeline do time."""
    if valor not in OPCOES_AGENTE or not os.path.exists(os.path.join(PIPE, "agents", f"{agente}.md")):
        sys.exit("Agente ou modelo desconhecido.")
    cfg = load()
    esc = cfg.setdefault("modelos_agentes", {})
    if valor == "oficial":
        esc.pop(agente, None)
    else:
        esc[agente] = valor
    save(cfg)
    gravar_modelo_agente(agente, modelo_oficial(agente) if valor == "oficial" else valor)


