def journify_token():
    """Conecta o Journify com o token colado no app (lido do stdin: não aparece no ps). Testa antes: um token
    recusado não apaga o que estava funcionando."""
    tok = sys.stdin.readline().strip().removeprefix("Bearer ").strip()
    if not tok:
        raise RuntimeError("Cole o token gerado no Journify.")
    try:
        mcp("minhas_tasks", servidor={"url": MCP_URL, "headers": {"Authorization": f"Bearer {tok}"}})
    except Exception as e:
        raise RuntimeError(f"O Journify não aceitou esse token: {e}") from None
    subprocess.run(["claude", "mcp", "remove", "journify", "--scope", "user"], capture_output=True)
    r = subprocess.run(["claude", "mcp", "add", "--transport", "http", "journify", MCP_URL,
                        "--header", f"Authorization: Bearer {tok}", "--scope", "user"], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(f"claude mcp add falhou: {(r.stderr or r.stdout).strip()[:200]}")


