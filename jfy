def blocos_task(cfg, t, full, largura):
    """Topo (projeto, título, indicadores) e rodapé (anexos, comentários) da task, em linhas."""
    pid, tk = t["projectId"], full["task"]
    topo = [c(f" {cfg['projetos'][pid]['nome']} ", cor_projeto(pid), True) + dim("─" * (largura - len(cfg['projetos'][pid]['nome']) - 2))]
    topo += [c(l, 255, True) for l in textwrap.wrap(t["title"], largura)]
    pts, n, pr = (tk.get("estimate") or {}).get("value"), dias_prazo(t), t.get("priority") or ""
    ind = [c("● " + t["statusId"].replace("_", " "), COR_STATUS.get(t["statusId"], 250)),
           c("▲ crítica", 203) if pr == "critica" else c("▲ alta", 214) if pr == "alta" else dim(pr.replace("media", "média"))]
    if pts:
        ind.append(c(f"{pts:g} pts".replace(".", ","), 250))
    ind.append(dim("sem prazo") if n is None else c("prazo " + date.fromisoformat(t["dueDate"][:10]).strftime("%d/%m"), 250)
               + (" · " + tag_prazo(t) if n <= JANELA else ""))
    topo += ["", "   ".join(ind)]
    if pts and pts > TETO_PR:
        topo.append(c(f"acima de {TETO_PR} pontos: não cabe num PR, divida a task antes", 203))
    anexos, coms, base = tk.get("attachments") or [], full.get("comments") or [], []
    imgs = [i for i, x in enumerate(anexos, 1) if (x.get("contentType") or "").startswith("image/")]
    docs = [f"{c(f'a{i}', 39, True)} {x.get('name', '?')}"[:largura + 20] for i, x in enumerate(anexos, 1) if i not in imgs]
    if imgs:
        docs.insert(0, f"{len(imgs)} {'imagem' if len(imgs) == 1 else 'imagens'}  " + c(faixas(imgs), 39, True))
    for k, l in enumerate(docs):
        base.append(c("ANEXOS".ljust(13) if k == 0 else " " * 13, 244, True) + l)
    if coms:
        u = coms[-1]
        txt = f"{u.get('authorName')}: " + " ".join((u.get("body") or "").split())
        base.append(c("COMENTÁRIOS".ljust(13), 244, True) + txt[:largura - 13]
                    + (dim(f"  +{len(coms) - 1} no d") if len(coms) > 1 else ""))
    return topo, base


def tela_task(cfg, t):
    full = mcp("obter_task", taskId=t["id"])  # uma busca só; p, w e anexo redesenham sem buscar de novo
    anexos = full["task"].get("attachments") or []
    while True:
        tam = shutil.get_terminal_size()
        largura = min(tam.columns or 100, 100) - 2
        topo, base = blocos_task(cfg, t, full, largura)
        desc = descricao(doc_texto(full["task"].get("description") or ""), anexos, largura)
        acoes = [dim("─" * largura), acoes_txt([("1", "implementar (/pipeline)"), ("2", "conversar com o Claude")], ""),
                 acoes_txt([("d", "descrição inteira")]
                           + ([("a1" + (f"–a{len(anexos)}" if len(anexos) > 1 else ""), "abre anexo")] if anexos else [])
                           + [("p", "prazo"), ("w", "Journify")])]
        # a descrição ocupa o que sobra da tela; o resto fica no d
        cabe = max(5, (tam.lines or 40) - len(topo) - len(base) - len(acoes) - 7)
        limpar()
        print("\n".join(" " + l for l in topo) + "\n")
        print(" " + c("O QUE FAZER", 244, True))
        print("\n".join(" " + l for l in desc[:cabe]) if desc else " " + dim("(sem descrição)"))
        if len(desc) > cabe:
            print(" " + dim(f"… mais {len(desc) - cabe} linhas · d lê a descrição inteira"))
        print("\n" + "\n".join(" " + l for l in (base + [""] if base else []) + acoes))
        op = escolha(seta(), "12dpw", prefixos={"a": len(anexos)})
        if op == "d":
            coms = [c(f"{x.get('authorName')}:", 39, True) + " " + (x.get("body") or "") for x in full.get("comments") or []]
            paginar("\n".join(
                topo + ["", c("O QUE FAZER", 244, True)] + (desc or [dim("(sem descrição)")]) + [""] + base
                + ([""] + coms if len(coms) > 1 else [])) + "\n")
        elif op == "w":
            abrir_link(f"{cfg.get('journify', JOURNIFY)}/projects/{t['projectId']}?task={t['id']}")
        elif op[:1] == "a" and op[1:].isdigit() and 1 <= int(op[1:]) <= len(anexos):
            abrir_link(anexos[int(op[1:]) - 1]["url"])  # só o link: nada é baixado para o disco
        elif op == "p":
            d = ler_data(ask("Prazo (25/11, 25/11/2026 ou +3 = daqui a 3 dias): "))
            if d:
                mcp("atualizar_task", taskId=t["id"], dueDate=d)
                t["dueDate"] = d
            else:
                ask(c("Data inválida. Enter para continuar.", 203))
        elif op in ("1", "2"):
            # já tem aba: só vai até ela, sem pedir notas que ela não leria
            extra = "" if aba(f"--run {t['id']}") else ask_texto("\n" + c("Algo a mais para o Claude?", 39, True) + dim(
                " Digite ou cole texto, arraste arquivos (prints, PDFs, planilhas) para cá. Linha vazia continua."))
            if extra:
                open(os.path.join(RUN_DIR, t["id"] + ".extra"), "w").write(extra)
            nome = f"{cfg['projetos'][t['projectId']]['nome'][:12]}: {t['title'][:24]}"
            return abrir_aba(nome, t["projectId"], "--run", t["id"], "pipeline" if op == "1" else "livre")
        elif op == "0":
            return


# seções da lista de tasks, na ordem do que pede ação sua primeiro; o status sai da linha porque a seção já diz
ETAPAS = ["URGENTE", "EM ANDAMENTO", "A FAZER", "ESPERANDO ALGUÉM", "BLOQUEADAS"]
ESPERA = {"em_revisao": "revisão", "em_teste": "teste", "pendente_validacao": "validação"}


def etapa(t):
    s = t["statusId"]
    return (0 if urgencia(t) is not None else 1 if s == "em_progresso" else 3 if s in ESPERA
            else 4 if s == "bloqueado" else 2)


def tela_projeto(cfg, pid):
    buscado = 0
    while True:
        if time.time() - buscado > 60:  # voltar de uma task não espera o Journify de novo; Enter força
            tasks = sorted(mcp("minhas_tasks", projetoId=pid),
                           key=lambda x: (etapa(x), urgencia(x) or 0,
                                          ORDEM.index(x["statusId"]) if x["statusId"] in ORDEM else len(ORDEM)))
            buscado = time.time()
        w = 12 if any(etapa(x) in (0, 3) or x.get("dueDate") for x in tasks) else 0
        itens, atual = [], None
        for x in tasks:
            if etapa(x) != atual:
                atual = etapa(x)
                itens.append((ETAPAS[atual],))
            col = c(ESPERA[x["statusId"]].ljust(w), 250) if atual == 3 else tag_prazo(x, w)
            st = ESPERA.get(x["statusId"]) or x["statusId"].replace("_", " ") if atual == 0 else ""
            tit = corta(x["title"], (shutil.get_terminal_size().columns or 100) - w - len(st) - 12)
            itens.append((f"{col}  " if w else "") + tit + (dim(f"  · {st}") if st else ""))
        nome = c(cfg["projetos"][pid]["nome"], cor_projeto(pid), True)
        op = menu(f"{nome} · minhas tasks ({len(tasks)})", itens or [(dim("nenhuma task sua neste projeto"),)],
                  [("s", "sessão (várias tasks num chat)"), ("l", "terminal livre"), ("c", "trocar repos"),
                   ("w", "Journify"), ("enter", "atualiza")], teclas="slcw")
        if op == "0":
            return
        if op == "":
            buscado = 0
        if op == "c":
            configurar(cfg, pid)
        elif op == "w":
            abrir_link(f"{cfg.get('journify', JOURNIFY)}/projects/{pid}")
        elif op == "l":
            abrir_aba(cfg["projetos"][pid]["nome"][:20] + ": livre", pid, "--livre", cfg["projetos"][pid]["repo"])
        elif op == "s":
            abrir_aba(cfg["projetos"][pid]["nome"][:20] + ": sessão", pid, "--sessao", pid)
        elif op.isdigit() and 1 <= int(op) <= len(tasks):
            tela_task(cfg, tasks[int(op) - 1])


