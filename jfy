def cronometro(acao=None):
    """Blocos de trabalho de hoje em ~/.jfy/dia.json. acao 'ligar': só se ainda não ligou hoje;
    'alternar': pausa/retoma; 'zerar': volta a zero e começa de novo agora. Devolve (minutos hoje, rodando?)."""
    # ponytail: bloco esquecido aberto morre na virada do dia; o dia seguinte começa do zero
    try:
        d = json.load(open(DIA))
    except (OSError, ValueError):
        d = {}
    if d.get("data") != date.today().isoformat():
        d = {"data": date.today().isoformat(), "blocos": []}
    b, agora = d["blocos"], time.time()
    rodando = bool(b) and b[-1][1] is None
    if acao == "zerar":
        b[:] = [[agora, None]]
    elif acao == "alternar" and rodando:
        b[-1][1] = agora
    elif acao == "alternar" or (acao == "ligar" and not b):
        b.append([agora, None])
    if acao:
        json.dump(d, open(DIA, "w"))
    return int(sum((f or agora) - i for i, f in b) // 60), bool(b) and b[-1][1] is None


def limites_ia():
