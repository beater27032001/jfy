def nome_livre(pasta, nome):
    """Um caminho na pasta para o arquivo, sem caracteres estranhos e sem sobrescrever outro de mesmo nome."""
    base = re.sub(r"[^\w.\- ()]+", "_", nome or "").strip(" .") or "arquivo"
    raiz, ext = os.path.splitext(base)
    alvo, n = os.path.join(pasta, base), 1
    while os.path.exists(alvo):
        n += 1
        alvo = os.path.join(pasta, f"{raiz} ({n}){ext}")
    return alvo


def baixar(url, destino, token=None, limite=30 << 20):
    """Baixa um anexo do Journify ou um arquivo do Drive para a pasta do contexto, até 30 MB."""
    req = urllib.request.Request(url, headers={"Authorization": "Bearer " + token} if token else {})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            dados = r.read(limite + 1)
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"o servidor recusou o download ({e.code})") from None
    if len(dados) > limite:
        raise RuntimeError(f"arquivo maior que {limite >> 20} MB: fica só o link")
    open(destino, "wb").write(dados)
    return destino


def drive_texto(url, pasta):
    """Arquivo do Google citado: Docs e Apresentações viram texto, Planilhas viram texto com todas as abas, e o resto
    (PDF, imagem) é baixado. Devolve (texto, None) ou (None, caminho)."""
    if not tem_drive():
        raise RuntimeError("o login do Google ainda não tem o Drive: entre de novo em Configurações › Google")
    tok, fid = google_token(), GOOGLE_ARQ.search(url)[1]
    meta = http_json(f"{DRIVE}/{fid}?fields=name,mimeType&supportsAllDrives=true", token=tok)
    tipo = meta["mimeType"]
    if tipo == "application/vnd.google-apps.spreadsheet":
        abas = [x["properties"]["title"] for x in http_json(f"{SHEETS}/{fid}?fields=sheets.properties.title", token=tok)["sheets"]]
        faixas = http_json(f"{SHEETS}/{fid}/values:batchGet?" + urllib.parse.urlencode(
            [("ranges", "'" + a.replace("'", "''") + "'") for a in abas]), token=tok).get("valueRanges", [])
        return (f"Planilha \"{meta['name']}\"\n\n" + "\n\n".join(
            f"### Aba {a}\n" + "\n".join(" | ".join(map(str, linha)) for linha in f.get("values", [])) for a, f in zip(abas, faixas)), None)
    if tipo.startswith("application/vnd.google-apps."):
        for fmt in (["text/markdown"] if tipo.endswith(".document") else []) + ["text/plain"]:
            try:
                req = urllib.request.Request(f"{DRIVE}/{fid}/export?mimeType={urllib.parse.quote(fmt)}", headers={"Authorization": "Bearer " + tok})
                return f"{meta['name']}\n\n" + urllib.request.urlopen(req, timeout=60).read().decode(errors="replace"), None
            except urllib.error.HTTPError as e:
                erro = f"o Google não exportou ({e.code})"
        raise RuntimeError(erro)
    return None, baixar(f"{DRIVE}/{fid}?alt=media&supportsAllDrives=true", nome_livre(pasta, meta["name"]), tok)


def secao_contexto(it, pasta):
    """Um item da cesta em texto para o CONTEXTO.md, com os arquivos dele baixados na pasta. Devolve (título, texto)."""
    tipo, ref, arqs = it["tipo"], it["ref"], os.path.join(pasta, "arquivos")
    rel = lambda x: os.path.relpath(x, pasta)
    if tipo == "task":
        full = mcp("obter_task", taskId=ref)
        t = full["task"]
        linhas = [f"id {ref} · status {t['statusId']} · prioridade {t.get('priority') or '-'} · prazo {(t.get('dueDate') or '-')[:10]}",
                  "", doc_texto(t.get("description") or "").strip() or "(sem descrição)"]
        for a in t.get("attachments") or []:
            try:
                linhas.append(f"Anexo: {rel(baixar(a['url'], nome_livre(arqs, a.get('name'))))}")
            except Exception as e:
                linhas.append(f"Anexo {a.get('name')} não baixou ({e}): {a.get('url')}")
        com = full.get("comments") or []
        if com:
            linhas += ["", "Comentários:"] + [f"- {x.get('authorName')} ({(x.get('createdAt') or '')[:10]}): {x.get('body') or ''}" for x in com]
        return t["title"], "\n".join(linhas)
    if tipo == "documento":
        d = mcp("obter_documento", docId=ref)
        if SENSIVEL.search(d.get("title") or ""):
            raise RuntimeError("parece guardar credenciais: não vai para o Claude")
        return d.get("title") or it["titulo"], d.get("content") or ""
    if tipo == "reuniao":
        r = reuniao_json(ref)
        return r["titulo"], f"Data: {r['data']}\nParticipantes: {', '.join(r['participantes'])}\n\n{r['resumo'] or '(sem resumo)'}"
    if tipo == "arquivo":
        return it["titulo"], "Arquivo: " + rel(baixar(ref, nome_livre(arqs, it["titulo"])))
    if tipo == "link":
        if GOOGLE_ARQ.search(ref):
            texto, arq = drive_texto(ref, arqs)
            return it["titulo"], f"{ref}\n\n" + (texto or "Arquivo: " + rel(arq))
        if "figma.com" in ref:
            return it["titulo"], f"{ref}\nLeia pelo MCP do Figma (get_design_context ou get_screenshot) se ele estiver ligado; se não, me peça um print."
        return it["titulo"], ref
    if tipo == "email":
        e = email_json(ref)
        conversa = "\n\n".join(f"--- {m['de']} ({m['data']}):\n{m['texto']}" for m in e["conversa"]) or e["texto"]
        return e["assunto"], (f"De: {e['de']}\nPara: {e['para']}\nData: {e['data']}"
                               + (f"\nAnexos do email (não baixados): {', '.join(a['nome'] for a in e['anexos'])}" if e["anexos"] else "") + f"\n\n{conversa}")
    if tipo == "pr":
        repo, n = ref.rsplit("#", 1)
        p = pr_json(repo, n)
        return f"{ref} {p['titulo']}", f"{p['url']}\n\n{p.get('corpo') or '(sem descrição)'}\n\nO diff: gh pr diff {n} -R {repo}"
    raise RuntimeError(f"tipo desconhecido: {tipo}")


def contexto_montar():
    """A cesta de contexto do app vira uma pasta em ~/.jfy/contexto: o CONTEXTO.md com o pedido e o texto de cada item
    (tasks, documentos, reuniões, emails, PRs, Docs e Planilhas do Google) e os arquivos baixados. Lê do stdin
    {"itens": [{tipo, ref, titulo, nota}], "pedido", "pid"}. Item que falha não para os outros: volta com o aviso."""
    d, cfg = json.loads(sys.stdin.read()), load()
    pasta = os.path.join(CTX_DIR, datetime.now().strftime("%Y-%m-%d-%H%M%S"))
    os.makedirs(os.path.join(pasta, "arquivos"))
    partes, itens = [], []
    for it in d["itens"]:
        try:
            titulo, texto, aviso = *secao_contexto(it, pasta), None
        except Exception as e:
            titulo, texto, aviso = it["titulo"], None, str(e)[:200]
            if it["tipo"] in ("link", "arquivo"):  # não leu, mas o link ainda serve (o Claude pode abrir pelo conector)
                texto = f"{it['ref']}\n(o jfy não leu o conteúdo: {aviso})"
        if texto is not None:
            nota = (it.get("nota") or "").strip()
            partes.append(f"## {ROTULO_CTX.get(it['tipo'], it['tipo'])}: {titulo}\n" + (f"\n> Nota minha: {nota}\n" if nota else "")
                          + f"\n{texto.strip()}\n")
        itens.append({"titulo": titulo or it["titulo"], "tipo": it["tipo"], "tokens": len(texto or "") // 4, "aviso": aviso})
    arqs = sorted(os.listdir(os.path.join(pasta, "arquivos")))
    pid, pedido = d.get("pid"), (d.get("pedido") or "").strip()
    proj = cfg["projetos"].get(pid or "", {}).get("nome")
    corpo = (f"# Contexto montado no jfy em {datetime.now():%d/%m/%Y %H:%M}" + (f" · projeto {proj}" if proj else "") + "\n\n"
             + (f"## O que eu quero\n\n{pedido}\n\n" if pedido else "")
             + (f"Arquivos baixados em {os.path.join(pasta, 'arquivos')}: {', '.join(arqs)}. Leia os que importarem.\n\n" if arqs else "")
             + "\n".join(partes))
    open(os.path.join(pasta, "CONTEXTO.md"), "w").write(corpo)
    meta = {"pasta": pasta, "pid": pid, "projeto": proj, "pedido": pedido, "arquivos": len(arqs), "itens": itens, "quando": time.time(),
            "tokens": len(corpo) // 4 + 1500 * len(arqs)}  # ponytail: arquivo conta ~1,5k tokens (uma imagem); PDF longo pesa mais
    json.dump(meta, open(os.path.join(pasta, "meta.json"), "w"))
    for velha in sorted(os.listdir(CTX_DIR))[:-30]:  # guarda as 30 últimas (o histórico do app)
        shutil.rmtree(os.path.join(CTX_DIR, velha), ignore_errors=True)
    return meta


def contexto_historico():
    """As cestas montadas, da mais nova para a mais velha (o app manda de novo)."""
    out = []
