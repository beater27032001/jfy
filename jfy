def instalar_windows():
    """O install.sh do Windows: o app roda a cada abertura e só mexe no que falta. A pipeline do time no ~/.claude (por
    cópia), o uso da IA no statusLine e o aviso do Claude nos hooks, apontando para o Python e o jfy desta instalação.
    Devolve o que fez e os avisos."""
    feito, avisos = [], []
    if not shutil.which("claude"):
        avisos.append("Falta o Claude Code: instale pelo instalador nativo (https://docs.claude.com/claude-code), não pelo npm.")
    if not shutil.which("git"):
        avisos.append("Falta o Git para Windows (https://git-scm.com): a pipeline e a aba GitHub precisam dele.")
    else:
        if os.path.isdir(os.path.join(PIPE, ".git")):
            agentes_oficial()  # o modelo que você trocou volta ao oficial para o pull, e a sua escolha volta depois dele
            if git(PIPE, "pull", "-q", "--ff-only").returncode:
                avisos.append("Não consegui atualizar a pipeline; segui com a versão que já estava.")
            agentes_aplicar()
        elif subprocess.run(["git", "clone", "-q", "https://github.com/Carloscavalcante97/pipeline-Claude.git", PIPE],
                            capture_output=True).returncode:
            avisos.append("Não consegui baixar a pipeline (github.com/Carloscavalcante97/pipeline-Claude).")
        if os.path.isdir(PIPE):
            avisos += [f"{os.path.relpath(m, os.path.expanduser('~'))} já existe e é diferente da pipeline oficial; mantive o seu."
                       for m in ligar_pipeline()]
            feito.append("/pipeline, agentes e hooks em ~/.claude")
    # barras normais: o Claude Code roda o comando pelo Git Bash, onde a barra invertida some
    eu = " ".join(f'"{x}"' if " " in x else x for x in (a.replace("\\", "/") for a in EU))
    p = os.path.expanduser("~/.claude/settings.json")
    try:
        st = json.load(open(p, encoding="utf-8")) if os.path.exists(p) else {}
    except ValueError as e:
        return {"feito": feito, "avisos": avisos + [f"~/.claude/settings.json não é um JSON válido ({e}): não mexi nele."]}
    do_jfy = lambda cmd, arg: "jfy" in cmd and arg in cmd
    sl = st.get("statusLine") or {}
    if not sl or do_jfy(sl.get("command", ""), "--statusline"):
        st["statusLine"] = {"type": "command", "command": f"{eu} --statusline"}
    elif "claude-status.json" not in sl.get("command", ""):
        avisos.append("Seu statusLine do Claude é outro: a barra de uso da IA do app fica sem dados.")
    hooks = st.setdefault("hooks", {})
    for ev, grupo in (("Stop", {}), ("Notification", {"matcher": "permission_prompt|elicitation_dialog"})):
        # tira só o comando do jfy de cada grupo (o caminho pode ter mudado) e põe o atual num grupo dele
        lista = [dict(g, hooks=[x for x in g.get("hooks", []) if not do_jfy(x.get("command", ""), "--avisar")]) for g in hooks.get(ev, [])]
        hooks[ev] = [g for g in lista if g["hooks"]] + [dict(grupo, hooks=[{"type": "command", "command": f"{eu} --avisar"}])]
    os.makedirs(os.path.dirname(p), exist_ok=True)
    json.dump(st, open(p, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
    feito.append("uso da IA e aviso do Claude no ~/.claude/settings.json")
    return {"feito": feito, "avisos": avisos}


