        else f"#[range=user|email fg=colour244]{ic('email')}#[norange]  "  # caixa zerada: só o ícone


def corpo_email(payload):
    """Texto de um email (payload do format=full): o text/plain; se não houver, o text/html sem as tags.
    Devolve (texto, [nomes dos anexos])."""
    import base64, html
    partes, achado, anexos = [payload], {}, [p["filename"] for p in partes_anexo(payload)]
    while partes:
        p = partes.pop(0)
        partes += p.get("parts", [])
        if not p.get("filename") and p.get("mimeType") in ("text/plain", "text/html") and p.get("body", {}).get("data"):
            achado.setdefault(p["mimeType"], base64.urlsafe_b64decode(p["body"]["data"] + "==").decode(errors="replace"))
    if "text/plain" in achado:
        return achado["text/plain"].strip(), anexos
    return html_texto(achado.get("text/html", "")), anexos


def partes_anexo(payload):
    """As partes de um email (format=full) que são anexo: as com nome e as fotos coladas no corpo, que às vezes vêm sem
    nome (ganham "imagem1.png"). O html vira texto sem as <img>, então é por aqui que a foto aparece."""
    out, partes = [], [payload]
    while partes:
        p = partes.pop(0)
        partes += p.get("parts", [])
        b, tipo = p.get("body", {}), p.get("mimeType") or ""
        if (p.get("filename") or tipo.startswith("image/")) and (b.get("attachmentId") or b.get("data")):
            out.append(dict(p, filename=p.get("filename") or f"imagem{len(out) + 1}.{tipo.split('/')[-1]}"))
    return out


def anexos_json(payload):
    """Os anexos de um email para o app: nome, tipo, tamanho e a parte (o --email-anexo baixa por ela)."""
    return [{"nome": p["filename"], "tipo": p.get("mimeType") or "", "parte": p.get("partId", ""),
             "tamanho": p.get("body", {}).get("size", 0)} for p in partes_anexo(payload)]


def dados_anexo(tok, mid, p):
    """Os bytes de uma parte de anexo: vem no corpo (pequena) ou se busca pelo attachmentId."""
    import base64
    b = p.get("body", {})
    return base64.urlsafe_b64decode((b.get("data") or http_json(f"{GMAIL}/{mid}/attachments/{b['attachmentId']}", token=tok)["data"]) + "==")


def email_anexo(mid, parte):
    """Baixa um anexo de um email para ~/.jfy/anexos/<email>/<parte>/ e devolve o caminho; o app mostra a foto ou abre o
    arquivo. Já baixado, não baixa de novo."""
    if not re.fullmatch(r"[0-9A-Za-z]+", mid) or not re.fullmatch(r"\d+(\.\d+)*", parte):
        sys.exit("Anexo inválido.")
    # ponytail: a pasta só cresce (o que você abriu); limpar por idade se pesar
    pasta = os.path.join(HOME, "anexos", mid, parte)
    if os.path.isdir(pasta) and os.listdir(pasta):
        return {"caminho": os.path.join(pasta, sorted(os.listdir(pasta))[0])}
    tok = caixa_google()
    m = http_json(f"{GMAIL}/{mid}?format=full", token=tok)
    p = next((p for p in partes_anexo(m["payload"]) if p.get("partId") == parte), None)
    if not p:
        sys.exit("Esse anexo não está mais no email.")
    dados = dados_anexo(tok, mid, p)
    os.makedirs(pasta, exist_ok=True)
    destino = nome_livre(pasta, p["filename"])
    open(destino, "wb").write(dados)
    return {"caminho": destino}


def html_texto(h):
    """HTML de email (corpo, assinatura) para texto: sem style/script, quebras nas tags de bloco."""
    import html
    h = re.sub(r"(?is)<(style|script|head)\b.*?</\1>", "", h)
    # o link fica: "texto <url>", como o Gmail faz no texto puro (o app mostra o <url> como link com o domínio)
    h = re.sub(r"""(?is)<a\b[^>]*?href\s*=\s*["']?(https?://[^"'\s>]+)[^>]*>(.*?)</a>""",
               lambda m: m[2] if html.unescape(re.sub(r"<[^>]+>", "", m[2])).strip() == html.unescape(m[1])
               else f"{m[2]} \ue000{m[1]}\ue001", h)  # marcadores: o "<url>" sairia junto com as tags
    h = re.sub(r"(?i)<br\s*/?>|</(p|div|tr|li|h\d)>", "\n", h)
    txt = html.unescape(re.sub(r"<[^>]+>", "", h)).replace("\ue000", "<").replace("\ue001", ">")
    return re.sub(r"\n\s*\n+", "\n\n", re.sub(r"[ \t\xa0]+", " ", txt)).strip()


def url_gmail(conta, frag="inbox"):
    """?authuser=<email> vai para essa conta entre as logadas no navegador e, se ela não estiver logada, o Google pede
    login. O /u/<email> dava "Temporary Error (404)" no navegador (ou perfil) sem a conta; o /u/0 abria outra conta."""
    return "https://mail.google.com/mail/" + (f"?authuser={urllib.parse.quote(conta, safe='@')}" if conta else "") + "#" + frag


