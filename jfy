def fechar(sid, cwd, pedido, repo):
    """Depois do /exit: handoff.md e memória, garantidos mesmo se o Claude não fez. Roda em segundo plano (jfy --fechar)
    para a aba fechar na hora; no fim tira o worktree, se ele ficou limpo (a branch continua)."""
    # ponytail: reabrir a task no mesmo repo antes disso acabar (~1 min) pode cruzar com a escrita do handoff.md
    arq = os.path.join(RUN_DIR, sid + ".fechar")
    open(arq, "w").write(pedido)
    subprocess.Popen([SELF, "--fechar", sid, cwd, repo, arq], start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=open(os.path.join(RUN_DIR, "fechar.log"), "a"))
    print(dim("handoff.md e memória do projeto: atualizando em segundo plano."))


def fechar_agora(sid, cwd, repo, arq):
    pedido = open(arq).read()
    os.remove(arq)
    # retoma a mesma conversa em modo headless, só com ferramentas de leitura/escrita de arquivo
    subprocess.call(["claude", "-p", "--resume", sid, "--permission-mode", "acceptEdits", "--allowedTools",
                     "Read", "Write", "Edit", "Glob", "Grep", "Bash(git log:*)", "Bash(git status:*)", "Bash(git diff:*)",
                     "Bash(ls:*)", "--", pedido], cwd=cwd, env=dict(os.environ, JFY_SEM_AVISO="1"),
                    stdout=subprocess.DEVNULL)
    limpar_worktree(repo, cwd)


def preparar_repo(repo, nome_wt):
    """Trava o repo para esta aba. Se outra aba já usa o repo, devolve um worktree."""
    lock = os.path.join(RUN_DIR, re.sub(r"\W", "_", repo))
    if ocupado(lock):
        return criar_worktree(repo, nome_wt), None
    open(lock, "w").write(str(os.getpid()))
    return repo, lock


def abrir_claude(cwd, contexto, pedido, lock, sid=None, extra=()):
    """Roda o Claude até o /exit. Devolve a hora (epoch) em que ele abriu."""
    cronometro("ligar")
    t0 = time.time()
    try:
        subprocess.call(["claude", "--append-system-prompt", contexto, *extra] + (["--session-id", sid] if sid else [])
                        + ([pedido] if pedido else []), cwd=cwd)
    finally:
        if lock:
            os.remove(lock)
    return t0


def limpar_worktree(repo, cwd):
    """Worktree sem nada pendente sai sozinho; a branch continua."""
    if cwd != repo and not git(cwd, "status", "--porcelain").stdout.strip():
        git(repo, "worktree", "remove", cwd)


def inicio(tid):
    """Liga o relógio da task e põe em progresso. Usado pelo Claude na sessão (jfy --inicio)."""
    open(os.path.join(RUN_DIR, tid + ".t"), "w").write(str(time.time()))
    mcp("atualizar_task", taskId=tid, statusId="em_progresso")
    print(f"Relógio ligado, status em_progresso: {tid}")


def fim(tid, minutos=None, pronta=False, nada=False, modo="sessao"):
    """Comenta o tempo gasto e, se pronta, muda o status. Sem minutos, usa o relógio do inicio() (sem as reuniões).
    O tempo também vai para o log de horas do dia."""
    arq = os.path.join(RUN_DIR, tid + ".t")
    if nada:  # só desliga o relógio, nada vai para o Journify
        if os.path.exists(arq):
            os.remove(arq)
        return print(dim("Nada registrado no Journify."))
    agora = time.time()
    ini = float(open(arq).read()) if os.path.exists(arq) else agora - 60 * (minutos or 1)
    if minutos is None:
        minutos = minutos_uteis(ini, agora)
    registrar_horas(ini, agora, minutos, modo, tid=tid)  # antes do Journify: o tempo foi trabalhado mesmo se ele falhar
    quando = datetime.now().strftime("%d/%m/%Y %H:%M")
    mcp("comentar_task", taskId=tid, texto=f"Tempo gasto: {fmt_min(minutos)} (Claude Code, encerrada em {quando})")
    if pronta:
        mcp("atualizar_task", taskId=tid, statusId=STATUS_FIM)
    if os.path.exists(arq):
        os.remove(arq)
    print(c(f"Journify atualizado: {fmt_min(minutos)}" + (f", status {STATUS_FIM}" if pronta else ""), 78))


