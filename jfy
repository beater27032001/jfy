def primeiros_passos():
    """Primeiro acesso (ou jfy --comecar): confere cada passo de verdade e guia só o que falta, em ordem.
    Enter faz, p pula, 0 deixa para depois. Passo já feito nem aparece como pergunta."""
    estado = [ok() for _, _, ok, _ in PASSOS]  # True feito, False falta, None pulado
    fez_algo = False
    for i, (nome, para, ok, guia) in enumerate(PASSOS):
        while estado[i] is False:
            limpar()
            print(c(f" jfy · primeiros passos  {i + 1} de {len(PASSOS)} ", 39, True) + "\n")
            for k, (n, p, *_) in enumerate(PASSOS):
                marca = (c("✓", 78, True) if estado[k] else dim("–") if estado[k] is None
                         else c("●", 39, True) if k == i else dim("○"))
                print(f" {marca} {c(n.ljust(16), 255, True) if k == i else n.ljust(16)} {dim(p)}")
            print("\n " + acoes_txt([("enter", f"fazer: {nome.lower()}"), ("p", "pular")], "0 deixa para depois (jfy --comecar)"))
            op = escolha(seta(), "p")
            if op == "0":
                gravar = load()
                gravar["comecou"] = True
                return save(gravar)
            if op == "p":
                estado[i] = None
                continue
            print()
            fez_algo = True
            r = guia(load())
            estado[i] = None if r is None else bool(r)  # None: o próprio passo desistiu (ex.: sem Journify)
    gravar = load()
    gravar["comecou"] = True
    save(gravar)
    if not fez_algo:  # já estava tudo pronto: direto para o menu
        return
    limpar()
    pulados = [n for (n, *_), e in zip(PASSOS, estado) if e is None]
    print(c(" jfy · tudo pronto ", 39, True) + "\n\n"
          + (dim(f" Ficou para depois: {', '.join(pulados)}. Rode jfy --comecar quando quiser.\n\n") if pulados else "")
          + " " + c("Como usar", 244, True) + "\n"
          + "\n".join(f" {c(k.ljust(9), 39, True)} {t}" for k, t in (
