def blocos_task(cfg, t, full, largura):
    """Topo (projeto, título, indicadores) e rodapé (anexos, comentários) da task, em linhas."""
    pid, tk = t["projectId"], full["task"]
    topo = [c(f" {cfg['projetos'][pid]['nome']} ", cor_projeto(pid), True) + dim("─" * (largura - len(cfg['projetos'][pid]['nome']) - 2))]
    topo += [c(l, 255, True) for l in textwrap.wrap(t["title"], largura)]
    pts, n, pr = (tk.get("estimate") or {}).get("value"), dias_prazo(t), t.get("priority") or ""
    ind = [c("● " + t["statusId"].replace("_", " "), COR_STATUS.get(t["statusId"], 250)),
           c("▲ crítica", 203) if pr == "critica" else c("▲ alta", 214) if pr == "alta" else dim(pr.replace("media", "média"))]
    if pts:
        ind.append(c(f"{pts:g} pts".replace(".", ","), 250))
    ind.append(dim("sem prazo") if n is None else c("prazo " + date.fromisoformat(t["dueDate"][:10]).strftime("%d/%m"), 250)
               + (" · " + tag_prazo(t) if n <= JANELA else ""))
    topo += ["", "   ".join(ind)]
    if pts and pts > 8:
        topo.append(c("acima de 8 pontos: o fluxo pede dividir a task antes", 203))
    anexos, coms, base = tk.get("attachments") or [], full.get("comments") or [], []
    imgs = [i for i, x in enumerate(anexos, 1) if (x.get("contentType") or "").startswith("image/")]
    docs = [f"{c(f'a{i}', 39, True)} {x.get('name', '?')}"[:largura + 20] for i, x in enumerate(anexos, 1) if i not in imgs]
    if imgs:
        docs.insert(0, f"{len(imgs)} {'imagem' if len(imgs) == 1 else 'imagens'}  " + c(faixas(imgs), 39, True))
    for k, l in enumerate(docs):
        base.append(c("ANEXOS".ljust(13) if k == 0 else " " * 13, 244, True) + l)
    if coms:
        u = coms[-1]
        txt = f"{u.get('authorName')}: " + " ".join((u.get("body") or "").split())
        base.append(c("COMENTÁRIOS".ljust(13), 244, True) + txt[:largura - 13]
                    + (dim(f"  +{len(coms) - 1} no d") if len(coms) > 1 else ""))
    return topo, base


def tela_task(cfg, t):
    full = mcp("obter_task", taskId=t["id"])  # uma busca só; p, w e anexo redesenham sem buscar de novo
    anexos = full["task"].get("attachments") or []
    while True:
        tam = shutil.get_terminal_size()
        largura = min(tam.columns or 100, 100) - 2
        topo, base = blocos_task(cfg, t, full, largura)
        desc = descricao(doc_texto(full["task"].get("description") or ""), anexos, largura)
        acoes = [dim("─" * largura), acoes_txt([("1", "implementar (/pipeline)"), ("2", "conversar com o Claude")], ""),
                 acoes_txt([("d", "descrição inteira")]
                           + ([("a1" + (f"–a{len(anexos)}" if len(anexos) > 1 else ""), "abre anexo")] if anexos else [])
                           + [("p", "prazo"), ("w", "Journify")])]
