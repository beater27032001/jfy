def vigiar():
    """De 2 em 2 min (o relógio da barra chama, em segundo plano): PR novo pedindo a sua revisão e evento adicionado,
    remarcado ou cancelado por outra pessoa e mensagem nova no chat viram notificação, e o clique abre o app na aba certa. A primeira vez só
    guarda o estado (não avisa o que já existia). Uma trava evita aviso em dobro com dois terminais abertos."""
    trava = os.path.join(RUN_DIR, "vigiar.trava")
    try:
        os.close(os.open(trava, os.O_CREAT | os.O_EXCL))
    except FileExistsError:
        if time.time() - os.path.getmtime(trava) < 300:
            return
        os.utime(trava)  # trava largada por um vigia que morreu
    try:
        st = json.load(open(VIGIAS)) if os.path.exists(VIGIAS) else {}
        for vigia in (vigiar_prs, vigiar_agenda, vigiar_chat, vigiar_emails):
            try:
                vigia(st)
            except Exception as e:  # sem rede, sem gh, sem Google: tenta de novo na próxima
                print(f"{datetime.now():%d/%m %H:%M} {vigia.__name__}: {e}", file=sys.stderr)
        json.dump(st, open(VIGIAS, "w"))
    finally:
        os.remove(trava)


def vigiar_prs(st):
    if not shutil.which("gh") or not contas_gh()[0]:
        return
    q = 'query { search(type: ISSUE, query: "is:pr is:open review-requested:@me", first: 50) { nodes { ... on PullRequest { number title repository { nameWithOwner } author { login } } } } }'
    nos = [n for n in gh("api", "graphql", "-f", "query=" + q)["data"]["search"]["nodes"] if n]
    agora = {f"{n['repository']['nameWithOwner']}#{n['number']}": n for n in nos}
    if "prs" in st:
        for k in [k for k in agora if k not in st["prs"]][:3]:
            n = agora[k]
            notificar("PR pede sua revisão", f"{n['title']} · {k} · de {(n.get('author') or {}).get('login', '?')}", app=f"pr/{k}")
    st["prs"] = sorted(agora)


def vigiar_agenda(st):
    if not load().get("google"):
        return
    agora = time.time()
    ini = datetime.now().astimezone()
    q = {"timeMin": ini.isoformat(), "timeMax": (ini + timedelta(days=14)).isoformat(), "singleEvents": "true", "maxResults": 500}
    itens = http_json(f"{CAL}?{urllib.parse.urlencode(q)}", token=google_token()).get("items", [])
    ts = lambda x: (datetime.fromisoformat(x["dateTime"].replace("Z", "+00:00")).timestamp() if "dateTime" in x
                    else datetime.combine(date.fromisoformat(x["date"]), datetime.min.time()).astimezone().timestamp())
    criado = lambda e: datetime.fromisoformat(e.get("created", "1970-01-01T00:00:00Z").replace("Z", "+00:00")).timestamp()
    atual = {e["id"]: [ts(e["start"]), e.get("summary") or "(sem título)", bool((e.get("organizer") or {}).get("self"))]
             for e in itens if e.get("status") != "cancelled"}
    quando = lambda t: ["seg", "ter", "qua", "qui", "sex", "sáb", "dom"][datetime.fromtimestamp(t).weekday()] + datetime.fromtimestamp(t).strftime(" %d/%m %H:%M")
    antes, visto = st.get("agenda"), st.get("agenda_em", 0)
    if antes is not None:
        avisos = []
        for i, (t, titulo, meu) in atual.items():
            e = next(x for x in itens if x["id"] == i)
            if i not in antes and not meu and criado(e) > visto - 60:  # novo de verdade, não só entrou na janela de 14 dias
                avisos.append(("Evento adicionado na sua agenda", f"{titulo} · {quando(t)}", f"evento/{i}"))
            elif i in antes and abs(antes[i][0] - t) > 60 and not meu:
                avisos.append(("Evento remarcado", f"{titulo} · de {quando(antes[i][0])} para {quando(t)}", f"evento/{i}"))
        for i, (t, titulo, meu) in antes.items():
            if i not in atual and t > agora and not meu:
                avisos.append(("Evento cancelado", f"{titulo} · era {quando(t)}", "agenda"))
        for titulo, texto, app in avisos[:5]:
            notificar(titulo, texto, app=app)
    st["agenda"], st["agenda_em"] = atual, agora


