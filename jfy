def notificar(titulo, texto, abrir=None, executar=None, app=None):
    """Notificação do macOS. Com o terminal-notifier (o install.sh instala), o clique traz o terminal e abre o link
    (`abrir`) ou roda o comando (`executar`, ex.: ir para a aba do Claude). Sem ele, ou sem permissão, a do osascript (o clique abre o Editor de Scripts).
    Cada aviso também vai para o histórico (NOTIFICACOES), com o mesmo clique, para a aba Notificações do app.
    `app` ("email/<id>", "pr/<dono/repo#n>", "evento/<id>", "aba/<janela>", "horas"…): com o jfy.app instalado, o clique
    abre o app já na aba certa (jfy://…); sem ele, vale o `executar` (ou nada)."""
    if app and APP_MAC and not abrir:
        abrir, executar = "jfy://" + urllib.parse.quote(app, safe="/"), None
    try:  # ponytail: cresce ~200 bytes por aviso; o app mostra só os 300 últimos e tem o botão Limpar
        with open(NOTIFICACOES, "a") as f:
            f.write(json.dumps({"ts": time.time(), "titulo": titulo, "texto": texto, "abrir": abrir, "executar": executar, "app": app},
                               ensure_ascii=False) + "\n")
    except OSError:
        pass  # sem histórico, o aviso sai do mesmo jeito
    if app_notifica():
        return  # o jfy.app está aberto e pode notificar: ele põe o aviso na tela, com o ícone dele e o clique certo
    if WIN:
        return  # no Windows quem notifica é o app; fechado, o aviso fica no histórico e ele mostra ao abrir
    tn = shutil.which("terminal-notifier") or next((x for x in ("/opt/homebrew/bin/terminal-notifier",
                                                                 "/usr/local/bin/terminal-notifier") if os.path.exists(x)), None)
    if tn:
        app = os.environ.get("__CFBundleIdentifier")  # o terminal de onde o jfy (ou o Claude) foi aberto
        extra = (["-open", abrir] if abrir else []) + (["-execute", executar] if executar else []) \
            + (["-activate", app] if app and not abrir else [])
        try:
            extra += ["-contentImage", "file://" + urllib.parse.quote(imagem_tema())]
        except Exception:  # sem imagem, a notificação sai do mesmo jeito
            pass
        if subprocess.run([tn, "-title", titulo, "-message", texto.lstrip("-[") or " ", "-sound", "Glass", *extra],
                          capture_output=True).returncode == 0:
            return
        # sem permissão em Ajustes > Notificações (ou outro erro): cai na do osascript para o aviso não sumir
    subprocess.run(["osascript", "-e", "on run a", "-e",
                    'display notification (item 2 of a) with title (item 1 of a) sound name "Glass"',
                    "-e", "end run", titulo, texto])


