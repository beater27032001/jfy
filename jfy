PROJ_JOURNIFY = os.path.join(HOME, "projetos_journify.json")  # os selects do modal do minhas-horas: projetos e categorias


def projetos_journify(forcar=False):
    """Os projetos (id, nome e etapas) e as categorias em que dá para lançar horas: o opcoes_horas do MCP, as mesmas do
    Minhas Horas. Guarda por 6 h em ~/.jfy/projetos_journify.json; sem o Journify, vale o guardado (mesmo velho).
    "jfy" = o id: os projetos do jfy usam o mesmo id do Journify."""
    try:
        d = json.load(open(PROJ_JOURNIFY))
    except (OSError, ValueError):
        d = {}
    velho = forcar or time.time() - d.get("em", 0) > 6 * 3600 or not all("id" in x for x in d.get("projetos") or [{}])
    if velho:
        try:
            o = mcp("opcoes_horas")
            d = {"em": time.time(), "categorias": o.get("categorias") or [],
                 "projetos": [{"id": x["id"], "jfy": x["id"], "nome": " ".join((x.get("name") or "").split()),
                               "etapas": [{"id": e["id"], "nome": " ".join((e.get("name") or "").split())} for e in x.get("etapas") or []]}
                              for x in o.get("projetos") or []]}
            json.dump(d, open(PROJ_JOURNIFY, "w"), ensure_ascii=False, indent=1)
        except Exception:  # sem rede ou sem MCP: o guardado (a lista antiga, raspada do modal, não tem id: fica de fora)
            pass
    return {"projetos": [x for x in d.get("projetos") or [] if "id" in x], "categorias": d.get("categorias") or []}


def projeto_journify(cfg, p):
    """O projeto do Journify de uma linha das horas: pelo id (o do jfy é o mesmo) ou pelo nome livre que você digitou."""
    pj = projetos_journify()["projetos"]
    nome = " ".join(str(nome_projeto(cfg, p) if p in cfg["projetos"] else p or "").lower().split())
    return next((x for x in pj if p and x["id"] == p), None) or next((x for x in pj if nome and x["nome"].lower() == nome), None)


def menu_projetos(cfg):
    """O menu de projeto das horas (aba Horas e "para as horas" da Agenda), igual ao select do Journify, com os nomes de
    lá. id = o do jfy quando ele conhece o projeto; senão o próprio nome (vira nome livre). Os do jfy fora da lista ficam."""
    pj = projetos_journify()["projetos"]
    ligados = {x["jfy"] for x in pj}
    return sorted([{"id": x["jfy"] or x["nome"], "nome": x["nome"], "cor": cor_hex(x["jfy"] or x["nome"])} for x in pj]
                  + [{"id": k, "nome": pr["nome"], "cor": cor_hex(k)} for k, pr in cfg["projetos"].items() if k not in ligados],
                  key=lambda x: x["nome"].lower())


def nome_journify(cfg, p):
    """O nome do projeto como está no Journify; sem a lista dele, o apelido do jfy (ou o nome livre)."""
    return next((x["nome"] for x in projetos_journify()["projetos"] if p and x["jfy"] == p), None) or nome_projeto(cfg, p)


def nome_projeto(cfg, info_ou_pid):
