def avisar():
    """Hook Stop/Notification do Claude Code (install.sh liga): notificação do macOS quando o Claude responde ou
    pede permissão. Não avisa se você já está olhando: terminal na frente e, dentro do tmux, a aba dele aberta."""
    if os.environ.get("JFY_SEM_AVISO"):  # claude -p do fechar(): ninguém está esperando essa resposta
        return
    d = json.load(sys.stdin)
    pane = os.environ.get("TMUX_PANE")  # "tmux" sem -L usa o servidor do $TMUX: serve para o jfy e para outro tmux
    tm = lambda fmt: subprocess.run(["tmux", "display", "-p", "-t", pane, fmt], capture_output=True, text=True).stdout.strip()
    sh = lambda *a: subprocess.run(a, capture_output=True, text=True).stdout.strip()
    na_frente = os.environ.get("__CFBundleIdentifier", "?") in sh("lsappinfo", "info", "-only", "bundleid", sh("lsappinfo", "front"))
    # ponytail: fora do tmux não dá para saber a aba do terminal; com o terminal na frente, conta como olhando
    aba_aberta = not pane or tm("#{window_active}") == "1" and tm("#{session_attached}") not in ("0", "")
    if na_frente and aba_aberta:
        return
    onde = tm("#W") if pane else os.path.basename(d.get("cwd", ""))
    titulo = "Claude precisa de você" if d.get("hook_event_name") == "Notification" else "Claude respondeu"
    import shlex
    sock = os.environ.get("TMUX", "").split(",")[0]
    ir = (" ".join(shlex.quote(x) for x in [shutil.which("tmux") or "tmux", "-S", sock, "select-window", "-t", pane])
          if pane and sock else None)  # clique na notificação: terminal na frente, já na aba deste Claude
    notificar(f"{titulo} · {onde}", " ".join((d.get("message") or d.get("last_assistant_message") or "").split())[:140] or "pronto",
              executar=ir)


# ---------- horas (minhas-horas do Journify) ----------
def minutos_uteis(ini, fim):
    """Minutos entre ini e fim (epoch) tirando as reuniões de hoje que caíram no meio."""
    # ponytail: só a agenda de hoje e reuniões sobrepostas descontam duas vezes; raro o bastante
    reun = sum(max(0, min(f, fim) - max(i, ini)) for i, f, *_ in eventos_hoje())
    return max(1, round((fim - ini - reun) / 60))


def registrar_horas(ini, fim, minutos, modo, tid=None, pid=None, titulo=None):
    """Uma linha por trabalho em ~/.jfy/horas/AAAA-MM-DD.jsonl (dia do início): base do jfy --horas."""
    linha = {k: v for k, v in dict(ini=ini, fim=fim, min=minutos, modo=modo, tid=tid, pid=pid, titulo=titulo).items()
             if v is not None}
    with open(os.path.join(HORAS_DIR, date.fromtimestamp(ini).isoformat() + ".jsonl"), "a") as f:
        f.write(json.dumps(linha, ensure_ascii=False) + "\n")


def inflar(linhas, dia, regra):
    """{(projeto, categoria, descrição): minutos medidos} -> minutos a lançar. A regra (config "horas") cobre o que
    o cronômetro não vê (entender a task, ler, conversar): 'fator' sobre o medido e 'minimo' do dia útil, com um
    quebrado de 5 a 55 min (o mesmo em toda rodada do dia) para não cravar a hora. O extra vai para as linhas de
    trabalho, proporcional ao medido; reunião tem hora marcada na agenda e fica como está. Múltiplos de 5 min."""
    medido = sum(linhas.values())
    if not medido:
        return {}
    alvo = medido * regra.get("fator", 1)
    if dia.weekday() < 5 and alvo < regra.get("minimo", 0):
        alvo = regra["minimo"] + random.Random(dia.isoformat()).randrange(5, 60, 5)
    alvo = 5 * math.ceil(alvo / 5)
    trabalho = {k: m for k, m in linhas.items() if k[1] != CATEGORIA["reuniao"]} or linhas
    extra, peso = alvo - medido, sum(trabalho.values())
    lanc = {k: max(5, 5 * int((m + extra * trabalho.get(k, 0) / peso) // 5)) for k, m in linhas.items()}
    lanc[max(trabalho, key=trabalho.get)] += alvo - sum(lanc.values())  # sobra do arredondamento na maior
    return lanc


def horas_do_dia(dia):
    """Linhas medidas do dia: o log do jfy (tasks, terminal livre, preparação de reunião) + reuniões da agenda.
    Devolve (linhas, reunioes): reunioes = {linha: (início, título, palpite?)} para poder definir projeto e contexto."""
    cfg, linhas, tasks = load(), {}, {}
    try:
        log = [json.loads(l) for l in open(os.path.join(HORAS_DIR, dia.isoformat() + ".jsonl"))]
    except OSError:
        log = []
    for e in log:
        tid = e.get("tid")
        if tid and tid not in tasks:
            try:
                tasks[tid] = mcp("obter_task", taskId=tid)["task"]
            except Exception:  # task apagada ou Journify fora: fica o id
                tasks[tid] = {"title": tid}
        t = tasks.get(tid, {})
        k = (e.get("pid") or t.get("projectId"), CATEGORIA.get(e["modo"], "Desenvolvimento"), e.get("titulo") or t.get("title"))
        linhas[k] = linhas.get(k, 0) + e["min"]
    try:
        evs = reunioes_do_dia(dia) if cfg.get("google") else []
    except Exception as e:
        print(c(f"Agenda fora ({e}): reuniões não entraram.", 214))
        evs = []
    reun = {}
    for i, f, titulo, *_ in evs:
        if i >= time.time():  # ainda não aconteceu
            continue
        info = reuniao_info(i, titulo)
        if info:  # você disse o projeto (r ou h): vale isso
            k = (info.get("pid") or info.get("projeto"), CATEGORIA["reuniao"], info.get("contexto") or titulo)
        else:  # palpite pelo apelido no título
            achado = projetos_no_texto(cfg, titulo)
            k = (achado[0] if len(achado) == 1 else None, CATEGORIA["reuniao"], titulo)
        linhas[k] = linhas.get(k, 0) + round((min(f, time.time()) - i) / 60)
        reun[k] = (i, titulo, not info)  # ponytail: duas reuniões na mesma linha (mesmo título e projeto): o número define a última
    return linhas, reun


def chave_reuniao(ini, titulo):
    return datetime.fromtimestamp(ini).strftime("%Y-%m-%d %H:%M ") + titulo


def reuniao_info(ini, titulo):
    """O que você registrou para a reunião: {"pid"} (projeto do jfy) ou {"projeto"} (nome livre), e "contexto"."""
    try:
        return json.load(open(REUNIOES)).get(chave_reuniao(ini, titulo))
    except (OSError, ValueError):
        return None


def gravar_reuniao(ini, titulo, reg):
    # ponytail: o arquivo cresce uns 100 bytes por reunião; limpar os antigos se um dia pesar
    try:
        dados = json.load(open(REUNIOES))
    except (OSError, ValueError):
        dados = {}
    dados[chave_reuniao(ini, titulo)] = reg
    json.dump(dados, open(REUNIOES, "w"), indent=1, ensure_ascii=False)


def nome_projeto(cfg, info_ou_pid):
    """Apelido do jfy, o nome livre que você digitou, ou '?'."""
    p = info_ou_pid if isinstance(info_ou_pid, str) or info_ou_pid is None else info_ou_pid.get("pid") or info_ou_pid.get("projeto")
    return cfg["projetos"].get(p, {}).get("nome", p) if p else "?"


def escolher_projeto(cfg, titulo, palpite=None):
    """Menu dos projetos do jfy. Enter aceita o palpite; texto livre = nome do projeto no Journify (ex.: Souv).
    Devolve {"pid"} ou {"projeto"}, ou None se voltou."""
    pids = sorted(cfg["projetos"], key=lambda p: cfg["projetos"][p]["nome"])
    op = menu(titulo, [c(cfg["projetos"][p]["nome"], cor_projeto(p)) + (dim("  ← enter") if p == palpite else "") for p in pids],
              [("número", "escolhe")] + ([("enter", nome_projeto(cfg, palpite))] if palpite else [])
              + [("ou escreva", "o nome do projeto no Journify (ex.: Souv)")])
    if op == "0" or (not op and not palpite):
        return None
    return ({"pid": pids[int(op) - 1]} if op.isdigit() and 1 <= int(op) <= len(pids)
            else {"projeto": op} if op and not op.isdigit()
            else {"pid": palpite} if palpite in cfg["projetos"] else {"projeto": palpite})


def classificar_reuniao(cfg, ini, titulo):
    """Projeto e contexto de uma reunião, só gravados (sem Claude). O apelido no título é só o palpite do Enter.
    Devolve o registro, ou None se voltou."""
    atual = reuniao_info(ini, titulo) or {}
    achado = projetos_no_texto(cfg, titulo)
    palpite = atual.get("pid") or atual.get("projeto") or (achado[0] if len(achado) == 1 else None)
    hora = datetime.fromtimestamp(ini).strftime("%d/%m %H:%M")
    reg = escolher_projeto(cfg, f"Projeto da reunião {hora} \"{titulo}\"", palpite)
    if reg is None:
        return None
    ctx = ask(f"Contexto, vira a descrição nas horas [{atual.get('contexto') or titulo}]: ", atual.get("contexto", ""))
    if ctx:
        reg["contexto"] = ctx
    gravar_reuniao(ini, titulo, reg)
    return reg


def rotulo_reuniao(cfg, info):
    if not info:
        return dim("sem projeto")
    p = info.get("pid") or info.get("projeto")
    return c(nome_projeto(cfg, info), cor_projeto(p)) + (dim(" · " + info["contexto"]) if info.get("contexto") else "")


def reunioes_do_dia(dia):
    return eventos_hoje() if dia == date.today() else agenda_google(dia)


def hm(m):
    return f"{m // 60}:{m % 60:02d}"


def ajustes_arq(dia):
    return os.path.join(HORAS_DIR, dia.isoformat() + ".ajustes.json")


def gravar_ajuste(dia, kid, **campos):
    """O que você mudou numa linha das horas (p, cat, desc, min, fora), só nesse dia. None/False tira o ajuste."""
    try:
        aj = json.load(open(ajustes_arq(dia)))
    except (OSError, ValueError):
        aj = {}
    a = aj.setdefault(kid, {})
    for k, v in campos.items():
        if v is None or v is False:
            a.pop(k, None)
        else:
            a[k] = v
    if not a:
        aj.pop(kid)
    json.dump(aj, open(ajustes_arq(dia), "w"), indent=1, ensure_ascii=False)


def itens_horas(cfg, dia):
    """As linhas do dia como vão para o Journify: o medido, com os seus ajustes e a regra do config.
    Devolve (itens, medido, total pela regra). Linha removida fica no fim, com fora=True."""
    linhas, reun = horas_do_dia(dia)
    try:
        aj = json.load(open(ajustes_arq(dia)))
    except (OSError, ValueError):
        aj = {}
    itens = []
    for k, m in linhas.items():
        r = reun.get(k)
        kid = "reuniao|" + chave_reuniao(*r[:2]) if r else "|".join(str(x) for x in k)  # reunião: estável mesmo trocando o projeto
        a = aj.get(kid, {})
        itens.append(dict(kid=kid, p=a.get("p", k[0]), cat=a.get("cat", k[1]), desc=a.get("desc", k[2]), med=m,
                          fixo=a.get("min"), fora=a.get("fora", False), reuniao=r, lanc=0))
    vivos = {(i, it["cat"]): it["med"] for i, it in enumerate(itens) if not it["fora"]}
    lanc = inflar(vivos, dia, cfg.get("horas", {}))
    for (i, _), m in lanc.items():
        # ponytail: hora fixada à mão substitui a da regra e não rebalanceia as outras linhas
        itens[i]["lanc"] = m if itens[i]["fixo"] is None else itens[i]["fixo"]
    itens.sort(key=lambda it: (it["fora"], -it["lanc"]))
    return itens, sum(vivos.values()), sum(lanc.values())


def editar_linha_horas(cfg, dia, it):
    """Muda uma linha (só nesse dia). Reunião: projeto e descrição vão para o reunioes.json, o mesmo do r."""
    if it["fora"]:  # removida: o número restaura
        return gravar_ajuste(dia, it["kid"], fora=False)
    limpar()
    print(c(" Editar lançamento ", 39, True) + f"  {dia.strftime('%d/%m/%Y')}\n")
    print(f" {c(nome_projeto(cfg, it['p']), cor_projeto(it['p']) if it['p'] else 214, True)} · {it['cat']} · "
          f"{c(hm(it['lanc']), 78, True)} · {it['desc']}\n")
    op = escolha(" " + acoes_txt([("p", "projeto"), ("c", "categoria"), ("h", "horas"), ("d", "descrição"),
                                  ("x", "remover")]) + "\n" + seta(), "pchdx")
    r = it["reuniao"]
    atual_reuniao = lambda: reuniao_info(*r[:2]) or ({"pid": it["p"]} if it["p"] in cfg["projetos"]
                                                     else {"projeto": it["p"]} if it["p"] else {})
    if op == "p":
        reg = escolher_projeto(cfg, f"Projeto de \"{it['desc']}\"", it["p"])
        if reg and r:
            ctx = (reuniao_info(*r[:2]) or {}).get("contexto")
            gravar_reuniao(*r[:2], dict(reg, **({"contexto": ctx} if ctx else {})))
        elif reg:
            gravar_ajuste(dia, it["kid"], p=reg.get("pid") or reg.get("projeto"))
    elif op == "c":
        cats = list(dict.fromkeys(CATEGORIA.values()))
        o = menu("Categoria", cats, [("número", "escolhe"), ("ou escreva", "outra")])
        cat = cats[int(o) - 1] if o.isdigit() and 1 <= int(o) <= len(cats) else o if o and not o.isdigit() else None
        if cat:
            gravar_ajuste(dia, it["kid"], cat=cat)
    elif op == "h":
        m = ask("  Horas (80, 1h20, 1:20) [enter = volta para a regra]: ")
        gravar_ajuste(dia, it["kid"], min=ler_minutos(m))
    elif op == "d":
        d = ask(f"  Descrição [{it['desc']}]: ")
        if d and r:
            gravar_reuniao(*r[:2], dict(atual_reuniao(), contexto=d))
        elif d:
            gravar_ajuste(dia, it["kid"], desc=d)
    elif op == "x":
        gravar_ajuste(dia, it["kid"], fora=True)


def tela_horas(dia=None):
    """jfy --horas [data] (ou h no menu): o que vai para o minhas-horas, uma linha por lançamento. Abre em hoje;
    o número edita a linha, - e + trocam o dia, l chama o Claude para lançar pelo Chrome."""
    cfg, dia = load(), dia or date.today()
    nome, regra = lambda p: nome_projeto(cfg, p), cfg.get("horas", {})
    while True:
        itens, medido, pela_regra = itens_horas(cfg, dia)
        vivos = [it for it in itens if not it["fora"]]
        total, larg = sum(it["lanc"] for it in vivos), min(shutil.get_terminal_size().columns or 100, 110)
        cab = f" Horas · {['seg', 'ter', 'qua', 'qui', 'sex', 'sáb', 'dom'][dia.weekday()]} {dia.strftime('%d/%m/%Y')} "
        limpar()
        print(c(cab, 39, True) + " " * max(2, larg - len(cab) - 16) + "lançar " + c(fmt_min(total), 78, True))
        traco = dim(" " + "─" * (larg - 2))
        print(traco)
        if not itens:
            print(dim("\n Nada medido nesse dia: nenhuma task ou terminal livre pelo jfy e nenhuma reunião na agenda.\n"))
        else:
            print(dim(f"     {'projeto':<12} {'categoria':<17} {'horas':>5}  descrição"))
        for n, it in enumerate(itens, 1):
            desc = it["desc"] + (" (projeto pelo título)" if it["reuniao"] and it["reuniao"][2] and it["p"] else "")
            desc, cat = desc[:max(12, larg - 46)], it["cat"][:17].ljust(17)
            if it["fora"]:
                print(dim(f" {n:>2}  {nome(it['p'])[:12]:<12} {cat} {'—':>5}  {desc}  · removida, o número restaura"))
                continue
            print(f" {c(f'{n:>2}', 39, True)}  {c(nome(it['p'])[:12].ljust(12), cor_projeto(it['p']) if it['p'] else 214)} {cat} "
                  f"{c(hm(it['lanc']).rjust(5), 78, True)}  {desc}" + (dim("  · horas à mão") if it["fixo"] is not None else ""))
        print(traco)
        if itens:
            fator = f"×{regra.get('fator', 1)}".replace(".", ",")
            minimo = (f" e mínimo {fmt_min(regra['minimo'])}" if dia.weekday() < 5 else " (fim de semana: sem mínimo)") \
                if regra.get("minimo") else ""
            print(dim(f" medido {fmt_min(medido)} · {fator}{minimo} → {fmt_min(pela_regra)}")
                  + (dim(f" · com seus ajustes: {fmt_min(total)}") if total != pela_regra else ""))
            sem = sum(1 for it in vivos if not it["p"])
            if sem:
                print(c(f" ⚠ {sem} linha(s) sem projeto: edite pelo número ou o Claude pergunta ao lançar", 214))
        prox = dia < date.today()
        op = escolha("\n " + acoes_txt(([("número", "edita")] if itens else []) + ([("l", "lança (Claude no Chrome)")] if vivos else [])
                                      + [("-", "dia anterior")] + ([("+", "próximo dia")] if prox else [])
                                      + [("ou a data", "20/11")], "0 fecha") + "\n" + seta(), "l-+")
        d = ler_data(op, futuro=False) if "/" in op else None
        if op == "0":
            return
        if op == "-":
            dia -= timedelta(days=1)
        elif op == "+" and prox:
            dia += timedelta(days=1)
        elif d and date.fromisoformat(d) <= date.today():
            dia = date.fromisoformat(d)
        elif op.isdigit() and 1 <= int(op) <= len(itens):
            editar_linha_horas(cfg, dia, itens[int(op) - 1])
        elif op == "l" and vivos:
            break
    linhas = "\n".join(f"- projeto: {nome(it['p'])} (id Journify {it['p'] if it['p'] in cfg['projetos'] else '?'}) | "
                       f"categoria: {it['cat']} | horas: {hm(it['lanc'])} | descrição: {it['desc']}" for it in vivos)
    pedido = f"""Lance estas horas de {dia.strftime('%d/%m/%Y')} em {cfg.get('journify', JOURNIFY)}/minhas-horas pelo Chrome (já estou logado). Um envio por linha:
{linhas}

- Projeto: o apelido acima é o do jfy (ou o nome do projeto no Journify, quando não tem id); escolha no select do modal o projeto do Journify que corresponde (o id ajuda). Se a linha tiver projeto "?" ou houver dúvida, me pergunte antes.
- Categoria: a opção do select mais próxima da sugerida.
- O modal usa Radix Select com <select> nativo escondido: setar o valor pelo setter nativo + eventos input/change funciona (projeto, categoria, tasks.0.regularHoursInput, input[type=date], textarea[name=description]). Ao trocar o projeto aparece um select "Etapa": ache os selects pelo conteúdo das opções, não pelo índice. Espere o modal abrir antes de preencher.
- Confira na tela se o dia já tem horas lançadas e me avise antes de duplicar. No fim, confirme que o total do dia ficou {hm(total)}."""
    subprocess.call(["claude", pedido], cwd=os.path.expanduser("~"))


# ---------- configuração de projeto ----------
def escolher_pasta(inicio):
    cur = inicio
    while True:
        subs = sorted((d for d in os.listdir(cur) if not d.startswith(".") and os.path.isdir(os.path.join(cur, d))), key=str.lower)
        limpar()
        print(c(" Escolha a pasta do repositório ", 39, True) + "\n " + c(cur, 214) + "\n")
        for i, d in enumerate(subs, 1):
            eh_git = os.path.isdir(os.path.join(cur, d, ".git"))
            print(f" {c(f'{i:>2}', 39, True)}  {c(d, 78) if eh_git else d}{dim('  git') if eh_git else ''}")
        print("\n " + acoes_txt([("número", "entra"), ("s", "usa esta pasta"), ("..", "sobe"), ("ou cole", "um caminho")]))
        op = ask(seta())
        if op == "0":
            return None
        if op == "s":
            return cur
        if op == "..":
            cur = os.path.dirname(cur)
            continue
        if op.isdigit() and 1 <= int(op) <= len(subs):
            alvo = os.path.join(cur, subs[int(op) - 1])
            if os.path.isdir(os.path.join(alvo, ".git")) and ask(f"Usar {c(alvo, 78)}? (enter = sim, n = entrar na pasta) ") != "n":
                return alvo
            cur = alvo
            continue
        alvo = os.path.join(cur, os.path.expanduser(op))
        if os.path.isdir(alvo):
            cur = os.path.realpath(alvo)
        else:
            ask(c("Pasta não existe. Enter para continuar.", 203))


def configurar(cfg, pid):
    p = cfg["projetos"].get(pid, {})
    ultimo = next((os.path.dirname(x["repo"]) for x in cfg["projetos"].values()), None)
    repo = escolher_pasta(os.path.dirname(p["repo"]) if p else ultimo or os.path.expanduser("~/Documents"))
    if not repo:
        return False
    padrao = p.get("nome") or os.path.basename(repo)
    nome = ask(f"Nome do projeto [{padrao}] (0 volta): ", padrao)
    if nome == "0":
        return False
    cfg["projetos"][pid] = {"nome": nome, "repo": repo}
    save(cfg)
    return True


# ---------- execução de uma task (roda na própria aba do tmux) ----------
def ocupado(lock):
    try:
        pid = int(open(lock).read())
        os.kill(pid, 0)
        return pid != os.getpid()
    except (OSError, ValueError):
        return False


def base(repo, tipo="feature"):
    """Ponto de partida gitflow, atualizado do remoto: develop; hotfix sai da main. Sem develop, main/master."""
    git(repo, "fetch", "-q", "origin")
    for n in (["main", "master"] if tipo == "hotfix" else ["develop", "main", "master"]):
        for ref in (f"origin/{n}", n):
            if git(repo, "rev-parse", "--verify", "--quiet", ref).returncode == 0:
                return ref
    return "HEAD"


def garantir_branch(repo, titulo):
    atual = git(repo, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if not atual or BRANCH_OK.match(atual):
        return
    op = ask(f"Branch atual '{atual}' não é gitflow. Criar a branch da task:\n"
             f"  1 feature  2 bugfix  (saem da develop atualizada)   3 hotfix (sai da main)   0 não criar\n> [1] ", "1")
    if op == "0":
        return
    tipo = {"2": "bugfix", "3": "hotfix"}.get(op, "feature")
    nova = f"{tipo}/{slug(titulo)}"
    if git(repo, "switch", nova).returncode != 0:
        subprocess.run(["git", "switch", "--no-track", "-c", nova, base(repo, tipo)], cwd=repo)


def criar_worktree(repo, titulo):
    # ponytail: worktree só quando o repo já tem outra task rodando; deps (node_modules, venv) não vêm junto
    branch = "feature/" + slug(titulo)
    wt = os.path.join(WT_DIR, os.path.basename(repo) + "-" + slug(titulo))
    if not os.path.isdir(wt):
        if git(repo, "worktree", "add", "--no-track", "-b", branch, wt, base(repo)).returncode != 0:
            subprocess.run(["git", "worktree", "add", wt, branch], cwd=repo, check=True)
        for f in os.listdir(repo):
            if f.startswith(".env") and os.path.isfile(os.path.join(repo, f)):
                shutil.copy2(os.path.join(repo, f), wt)
    print(c(f"Repo ocupado por outra task: usando worktree {wt} ({branch})", 214))
    return wt


