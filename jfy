def categoria_arquivo(nome, tipo):
    """As categorias da aba Arquivos do Journify: Documentos, Planilhas, Imagens ou Outros."""
    t, ext = (tipo or "").lower(), os.path.splitext(nome or "")[1].lower()
    if t.startswith("image/"):
        return "Imagens"
    if "sheet" in t or "excel" in t or ext in (".xlsx", ".xls", ".csv", ".ods"):
        return "Planilhas"
    if t.startswith("text/") or any(x in t for x in ("pdf", "word", "document", "presentation")) \
            or ext in (".pdf", ".doc", ".docx", ".txt", ".md", ".odt", ".ppt", ".pptx", ".key", ".pages"):
        return "Documentos"
    return "Outros"


