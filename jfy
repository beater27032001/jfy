# (tipo, regex no comando, ícone, cor 256 fora das que os temas trocam): vale o primeiro que casar, então o
# específico vem antes do genérico (firebase e next antes de node/java)
TECNOLOGIAS = [
    ("firebase", r"firebase|cloud-firestore-emulator|pubsub-emulator", "chama", 208),
    ("expo", r"\bexpo\b|react-native|\bmetro\b", "celular", 117),
    ("next", r"\bnext\b|next-server|next/dist", "next", 231),
    ("vite", r"\bvite\b", "raio", 135),
    ("node", r"\b(node|bun|deno)\b", "node", 71),
    ("python", r"python|uvicorn|gunicorn|celery|manage\.py", "python", 33),
    ("java", r"\bjava\b", "cafe", 172),
    ("docker", r"com\.docker|\bdocker\b|vpnkit", "docker", 38),
    ("postgres", r"postgres", "postgres", 67),
    ("mysql", r"mysqld|mariadb", "mysql", 30),
    ("redis", r"redis", "redis", 160),
    ("mongo", r"mongod", "folha", 70),
    ("ruby", r"\bruby\b|rails|puma", "gema", 124),
]


def tecnologia(cmd):
    return next((t for t in TECNOLOGIAS if re.search(t[1], cmd.lower())), None)


def containers():
    """Porta do Mac -> (nome, imagem) de cada container rodando. Sem Docker: vazio."""
    try:
        out = subprocess.run(["docker", "ps", "--format", "{{.Names}}\t{{.Image}}\t{{.Ports}}"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return {int(pt): (nome, img) for nome, img, pts in (l.split("\t") for l in out.splitlines() if l.count("\t") == 2)
            for pt in re.findall(r":(\d+)->", pts)}


def lsof_campos(*args):
    """lsof -F: {pid: [valores do campo n]}."""
    r, pid = {}, None
    for l in subprocess.run(["lsof", *args], capture_output=True, text=True).stdout.splitlines():
        if l[:1] == "p":
            pid = int(l[1:])
        elif l[:1] == "n":
            r.setdefault(pid, []).append(l[1:])
    return r


def processos_windows():
    """No Windows não há lsof nem ps: as portas em escuta e os processos (pai, linha de comando, nome) numa chamada só
    ao PowerShell. Devolve ({pid: {portas}}, {pid: (ppid, comando)}, {pid: nome})."""
    # ponytail: o Get-CimInstance leva ~1 s; a tela Portas olha de tempos em tempos, então serve
    script = ("[Console]::OutputEncoding = [Text.Encoding]::UTF8; "
              "$c = @(Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Select-Object LocalPort, OwningProcess); "
              "$p = @(Get-CimInstance Win32_Process | Select-Object ProcessId, ParentProcessId, CommandLine, Name); "
              "@{c = $c; p = $p} | ConvertTo-Json -Depth 3 -Compress")
    r = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", script], capture_output=True,
                       encoding="utf-8", errors="replace")
    d = json.loads(r.stdout or '{"c": [], "p": []}')
    abertas = {}
    for x in d.get("c") or []:
        if x["OwningProcess"] > 4:  # 0 e 4: o próprio Windows
            abertas.setdefault(x["OwningProcess"], set()).add(x["LocalPort"])
    ps = {x["ProcessId"]: (x["ParentProcessId"] or 0, x["CommandLine"] or x["Name"] or "") for x in d.get("p") or []}
    return abertas, ps, {x["ProcessId"]: x["Name"] or "" for x in d.get("p") or []}


def portas():
    """Portas TCP abertas por programas de desenvolvimento: o que é, de que projeto, se tem Claude no repo e como parar.
    Fica de fora o que não é de desenvolvimento (Figma, CleanMyMac, o próprio macOS)."""
    cfg, casa = load(), os.path.expanduser("~")
    raizes = [(os.path.realpath(r), k) for k, pr in cfg["projetos"].items() for r in repos_de(pr)]
    if WIN:
        abertas, ps, nomes = processos_windows()
        claudes = {pid for pid, n in nomes.items() if n.lower() == "claude.exe"}
        # ponytail: o Windows não dá a pasta de trabalho de outro processo; o projeto sai do caminho na linha de comando
        # (node C:\repo\node_modules\...). Servidor sem o caminho do repo na linha fica sem projeto, e "Claude aberto
        # neste repo" não aparece
        cmd_de = lambda pid: os.path.normcase(ps.get(pid, (0, ""))[1].replace("/", "\\"))
        cwd = {pid: next((r for r, _ in raizes if os.path.normcase(r) in cmd_de(pid)), "/") for pid in abertas}
    else:
        abertas = {pid: {int(n.rsplit(":", 1)[1]) for n in ns} for pid, ns in lsof_campos("-nP", "-iTCP", "-sTCP:LISTEN", "-Fpn").items()}
        ps = {}  # pid -> (ppid, comando)
        for l in subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True).stdout.splitlines():
            a, b, cmd = (l.split(None, 2) + [""])[:3]
            ps[int(a)] = (int(b), cmd)
        nomes = {pid: os.path.basename(cmd.split(" ")[0]) for pid, (_, cmd) in ps.items()}
        claudes = {pid for pid, n in nomes.items() if n == "claude"}
        cwd = {pid: os.path.realpath(ns[0]) for pid, ns in
               (lsof_campos("-a", "-d", "cwd", "-Fn", "-p", ",".join(map(str, [*abertas, *claudes]))) if abertas else {}).items()}
    paineis = ([[x["cwd"], x["nome"]] for x in app_abas("listar")["abas"]] if APP else
               [l.split("\t", 1) for l in subprocess.run(TMUX + ["list-panes", "-a", "-F", "#{pane_current_path}\t#{window_name}"],
                                                          capture_output=True, text=True).stdout.splitlines() if "\t" in l])
    dentro = lambda pasta, raiz: os.path.normcase(pasta) == os.path.normcase(raiz) or \
        os.path.normcase(pasta).startswith(os.path.normcase(raiz) + os.sep)
    docker, linhas = containers(), []

    def pelo_claude(pid):  # o Claude subiu o servidor (npm run dev num Bash dele) e ele ficou rodando
        for _ in range(30):
            pid = ps.get(pid, (0,))[0]
            if pid in claudes:
                return True
            if pid <= 1:
                return False
        return False

    for pid, pts in abertas.items():
        tec = tecnologia(ps.get(pid, (0, ""))[1])
        if tec and tec[0] == "docker":  # quem abre a porta é o Docker: uma linha por container
            for nome, img in sorted({docker[pt] for pt in pts if pt in docker}):
                t = tecnologia(img) or tec
                linhas.append({"portas": sorted(pt for pt in pts if docker.get(pt) == (nome, img)), "tipo": t[0], "icone": t[2],
                               "cor": t[3], "nome": nome, "notas": [f"container Docker ({img})"], "parar": "docker:" + nome})
            continue
        pasta = cwd.get(pid, "/")
        k, raiz = next(((k, r) for r, k in raizes if dentro(pasta, r)
                        or pasta.startswith(os.path.join(os.path.realpath(WT_DIR), os.path.basename(r) + "-"))), (None, None))
        if not tec and not k:
            continue
        raiz = raiz or (pasta if pasta not in ("/", casa) and not pasta.startswith("/opt/") else None)
        aba = next((n for caminho, n in paineis if raiz and dentro(os.path.realpath(caminho), raiz)), None)
        claude = raiz and any(dentro(cwd.get(c, "/"), raiz) for c in claudes)
        t = tec or ("outro", "", "sinal", 245)
        notas = [x for x in (os.path.basename(pasta) if k else "", f"aba do jfy: {aba}" if aba else "Claude aberto neste repo" if claude else "",
                             "aberta pelo Claude" if pelo_claude(pid) else "", f"processo {pid}") if x]
        linhas.append({"portas": sorted(pts), "tipo": t[0], "icone": t[2], "cor": t[3], "parar": str(pid), "notas": notas,
                       "nome": cfg["projetos"][k]["nome"] if k else os.path.basename(pasta) if raiz else nomes.get(pid, "")})
    return sorted(linhas, key=lambda x: x["portas"][0])


def txt_portas(x):
    return ", ".join(map(str, x["portas"][:3])) + ("…" if len(x["portas"]) > 3 else "")


def encerrar(alvo):
    """alvo: pid ou docker:<container>. Pede para sair; se em 3s não saiu, força. Devolve se parou."""
    if alvo.startswith("docker:"):
        return subprocess.run(["docker", "stop", alvo[7:]], capture_output=True).returncode == 0
    pid = int(alvo)
    if WIN:  # pede para fechar (a árvore toda: o npm e o node que ele abriu); em 3 s, força
        for forca in ([], ["/F"]):
            subprocess.run(["taskkill", *forca, "/T", "/PID", str(pid)], capture_output=True)
            for _ in range(30):
                time.sleep(0.1)
                if not vivo(pid):
                    return True
        return False
    for sinal in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.kill(pid, sinal)
            for _ in range(30):
                time.sleep(0.1)
                os.kill(pid, 0)
        except ProcessLookupError:
            return True
        except PermissionError:
            return False
    return False


