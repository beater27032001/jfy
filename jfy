def fotos_pessoas():
    """{email: url da foto} das pessoas do domínio, pela People API (o diretório do Workspace), como o Google Agenda
    mostra. Lê de novo a cada 24 h (com erro, a cada 6 h); fica de fora quem não pôs foto (o Google devolve a letra
    padrão, e o app desenha as iniciais na cor da pessoa). Sem a permissão do diretório (login antigo) ou com a People
    API desligada no projeto do Google, fica vazio e o app segue com as iniciais."""
    global _fotos
    if _fotos is not None:
        return _fotos
    try:
        st = json.load(open(FOTOS))
    except (OSError, ValueError):
        st = {}
    if tem_diretorio() and time.time() - st.get("em", 0) > (6 if st.get("erro") else 24) * 3600:
        fotos, pagina = {}, None
        try:
            while True:
                q = {"readMask": "emailAddresses,photos", "sources": "DIRECTORY_SOURCE_TYPE_DOMAIN_PROFILE", "pageSize": 1000,
                     **({"pageToken": pagina} if pagina else {})}
                r = http_json(f"https://people.googleapis.com/v1/people:listDirectoryPeople?{urllib.parse.urlencode(q)}", token=google_token())
                for x in r.get("people", []):
                    url = next((f["url"] for f in x.get("photos", []) if f.get("url") and not f.get("default")), None)
                    for e in x.get("emailAddresses", []):
                        if url and e.get("value"):
                            fotos[e["value"].lower()] = url
                pagina = r.get("nextPageToken")
                if not pagina:
                    break
            st = {"em": time.time(), "fotos": fotos}
        except Exception as e:  # People API desligada no projeto, sem rede: tenta de novo daqui a 6 h
            st = {"em": time.time(), "fotos": st.get("fotos", {}), "erro": str(e)[:200]}
        json.dump(st, open(FOTOS, "w"), ensure_ascii=False)
    _fotos = st.get("fotos", {})
    return _fotos


