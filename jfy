    op = escolha(" Pronta? Registra o tempo e move para:  " + "   ".join(f"{i} {status(s)}" for i, s in enumerate(FINAIS, 1))
                 + "\n 4 não pronta: só registrar o tempo   5 não registrar nada\n> [4] ", "12345") or "4"
    if op == "5":
        return None
    novo = FINAIS[int(op) - 1] if op in ("1", "2", "3") else None
    video = motivo = None
    if novo == "fechado":  # o Journify só fecha task de projeto com o vídeo do teste ou o motivo de não ter
